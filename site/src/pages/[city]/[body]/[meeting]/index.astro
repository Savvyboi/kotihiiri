---
import Base from '../../../../layouts/Base.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import SourceLink from '../../../../components/SourceLink.astro';
import { t, localePath, formatDate } from '../../../../i18n';
import { cities, meetingFiles, bodyName, bodySlug, meetingSegment, itemUrl, type City, type MeetingFile } from '../../../../lib/data';

export function getStaticPaths() {
  return cities().flatMap((city) => meetingFiles(city.id).map((file) => ({
    params: { city: city.id, body: bodySlug(file.meeting.body_id), meeting: meetingSegment(file.meeting.id) },
    props: { city, file },
  })));
}
interface Props { city: City; file: MeetingFile }
const { city, file } = Astro.props;
const { meeting, items } = file;
const body = bodyName(meeting.body_id);
const date = formatDate(meeting.date);
const present = meeting.attendance.filter((a) => a.present);
const absent = meeting.attendance.filter((a) => !a.present);
---
<Base title={`${body} ${date} · ${city.name_fi}`} city={city.id}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumb items={[
        { label: city.name_fi, href: `/${city.id}/` },
        { label: body, href: `/${city.id}/${bodySlug(meeting.body_id)}/` },
        { label: date },
      ]} />
      <p class="eyebrow">{body}</p>
      <h1>{t('meeting.title', { date })}</h1>
      <ul class="meta">
        <li><span class="badge">{t(`meeting.stage.${meeting.stage}`)}</span></li>
        {meeting.start_time && <li>{t('meeting.time')}: {meeting.start_time}{meeting.end_time && `–${meeting.end_time}`}</li>}
        {meeting.location && <li>{t('meeting.place')}: {meeting.location}</li>}
      </ul>
    </div>
  </section>
  <div class="wrap two-col">
    <section>
      {meeting.stage === 'agenda' && <p class="empty" style="margin-top:1.5rem">{t('meeting.agendaNotice')}</p>}
      <h2>{t('meeting.items')}</h2>
      <ul class="list">
        {items.map((item) => (
          <li><span class="pykala">{item.pykala ? `${item.pykala} §` : `${item.ordinal}.`}</span>
            <span><a href={localePath(itemUrl(item))}>{item.title}</a>
            {item.votes.length > 0 && <span class="small muted"> · {item.votes.length} {t('city.stats.votes')}</span>}</span></li>
        ))}
      </ul>
    </section>
    <aside>
      {(meeting.video_url || meeting.minutes_pdf_url) && <h2>{t('city.source')}</h2>}
      {meeting.video_url && <p><a href={meeting.video_url} rel="external noopener">{t('meeting.video')}</a></p>}
      {meeting.minutes_pdf_url && <p><a href={meeting.minutes_pdf_url} rel="external noopener">{t('meeting.minutesPdf')}</a></p>}
      {meeting.stage === 'minutes' && meeting.attendance.length > 0 && <>
        <h2>{t('meeting.attendance')}</h2>
        <details open><summary>{t('meeting.present')} ({present.length})</summary>
          <ul class="small" style="padding-left:1.1rem">{present.map((a) => <li>{a.person_ref.raw} <span class="muted">{a.role_text}</span>{a.note && <span class="muted"> · {a.note}</span>}</li>)}</ul>
        </details>
        {absent.length > 0 && <details><summary>{t('meeting.absent')} ({absent.length})</summary>
          <ul class="small" style="padding-left:1.1rem">{absent.map((a) => <li>{a.person_ref.raw} <span class="muted">{a.role_text}</span></li>)}</ul>
        </details>}
      </>}
      <SourceLink href={meeting.source_url} system={city.source_name} />
    </aside>
  </div>
</Base>
