---
import Base from '../../layouts/Base.astro';
import CityCard from '../../components/CityCard.astro';
import VoteCard from '../../components/VoteCard.astro';
import { localeParams, useI18n, type Key, type Locale } from '../../i18n';
import { TOPICS, topicRows } from '../../lib/topics';
import { cities, majorCities, otherMunicipalities, cityName, cityStats, disabledKey, meetingFiles, recentVotes, bodyName, meetingUrl, itemUrl, decisionText } from '../../lib/data';

export function getStaticPaths() {
  return localeParams().map(({ lang, locale }) => ({ params: { lang }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, path, shared, date, num } = useI18n(locale);
const others = otherMunicipalities().filter((c) => c.enabled);
// Municipalities not followed yet, in their own folded section, grouped by why (§18.1).
const notYet = cities().filter((c) => !c.enabled);
const reasons = (['city.disabled', 'city.noAdapter', 'city.coming'] as const)
  .map((k) => ({ k, list: notYet.filter((c) => disabledKey(c) === k).sort((a, b) => a.rank - b.rank) }))
  .filter((g) => g.list.length);

const enabled = cities().filter((c) => c.enabled);
const votes = enabled.flatMap((c) => recentVotes(c.id, 3).map((row) => ({ row, city: c.id })))
  .sort((a, b) => b.row.meeting.date.localeCompare(a.row.meeting.date)).slice(0, 6);
const decisions = enabled.flatMap((c) => meetingFiles(c.id)
  .filter((f) => f.meeting.stage !== 'agenda')
  .flatMap((f) => f.items.filter((i) => decisionText(i)).map((i) => ({ item: i, meeting: f.meeting, city: c }))))
  .sort((a, b) => b.meeting.date.localeCompare(a.meeting.date)).slice(0, 8);
const today = new Date().toISOString().slice(0, 10);
const upcoming = enabled.flatMap((c) => meetingFiles(c.id).filter((f) => f.meeting.stage === 'agenda' && f.meeting.date >= today)
  .map((f) => ({ meeting: f.meeting, city: c }))).sort((a, b) => a.meeting.date.localeCompare(b.meeting.date)).slice(0, 6);
const totals = enabled.map((c) => cityStats(c.id)).reduce((s, x) => ({
  meetings: s.meetings + x.meetings, items: s.items + x.items, votes: s.votes + x.votes,
}), { meetings: 0, items: 0, votes: 0 });
const byTopic = topicRows();
const topics = TOPICS.map((tp) => ({ id: tp.id, n: byTopic.get(tp.id)?.length ?? 0 }))
  .filter((x) => x.n && x.id !== 'ilmoitusasiat').sort((a, b) => b.n - a.n);
---
<Base locale={locale}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t('site.name')}</p>
      <h1>{t('home.title')}</h1>
      <p class="lead">{t('home.lead')}</p>
      <ul class="stats">
        <li><b>{num(enabled.length)}</b> {t('home.stats.munis')}</li>
        <li><b>{num(totals.meetings)}</b> {t('home.stats.meetings')}</li>
        <li><b>{num(totals.items)}</b> {t('home.stats.items')}</li>
        <li><b><a href={path('/aanestykset/')}>{num(totals.votes)}</a></b> {t('home.stats.votes')}</li>
      </ul>
    </div>
  </section>
  <div class="wrap">
    <h2>{t('home.cities')}</h2>
    <div class="grid">{majorCities().filter((c) => c.enabled).map((c) => <CityCard city={c} locale={locale} />)}</div>

    <section id="kunnat" class="municipalities">
      <h2>{t('home.municipalities')}</h2>
      <p class="muted">{t('home.municipalitiesLead')}</p>
      <label class="filter"><span class="visually-hidden">{t('home.filter')}</span>
        <input type="search" placeholder={t('home.filter')} data-muni-filter autocomplete="off" /></label>
      <ul class="muni-list" data-muni-list>
        {others.map((c) => {
          const s = cityStats(c.id);
          return (
            <li data-name={[c.name_fi, c.name_sv].filter(Boolean).join(' ').toLowerCase()}>
              <a href={path(`/${c.id}/`)}>{cityName(c, locale)}</a>
              <span class="small muted">{c.population ? `${num(c.population)} ${t('common.inhabitants')}` : ''}</span>
              <span class="small">{num(s.meetings)} {t('city.stats.meetings')}{s.votes > 0 && <> · {num(s.votes)} {t('home.stats.votes')}</>}</span>
            </li>
          );
        })}
      </ul>
      <p class="muted" data-muni-empty hidden>{t('home.noMatch')}</p>
    </section>

    {reasons.length > 0 && (
      <section class="not-followed">
        <details>
          <summary><h2>{t('home.notFollowed', { n: num(notYet.length) })}</h2></summary>
          <p class="muted">{t('home.notFollowedLead')}</p>
          {reasons.map((g) => (
            <div class="nf-group">
              <h3><span class="badge">{t(g.k)}</span> <span class="small muted">{num(g.list.length)}</span></h3>
              <p class="nf-list">{g.list.map((c, i) => <>{i > 0 && ', '}<a href={path(`/${c.id}/`)}>{cityName(c, locale)}</a></>)}</p>
            </div>
          ))}
        </details>
      </section>
    )}

    <h2>{t('home.latestVotes')}</h2>
    {votes.length
      ? <div class="grid vote-grid">{votes.map(({ row, city }) => <VoteCard row={row} showCity={city} locale={locale} />)}</div>
      : <p class="empty">{t('city.empty')}</p>}
    <p><a href={path('/aanestykset/')}>{t('home.allVotes')}</a></p>

    {topics.length > 0 && <section>
      <h2>{t('home.topics')}</h2>
      <ul class="topic-chips">
        {topics.map((x) => <li><a href={path(`/aiheet/${x.id}/`)}>{t(`topic.${x.id}` as Key)} <span class="muted">{num(x.n)}</span></a></li>)}
      </ul>
    </section>}

    <div class="two-col">
      <section>
        <h2>{t('home.latest')}</h2>
        {decisions.length ? (
          <ul class="list">
            {decisions.map(({ item, meeting, city }) => (
              <li><span class="date">{date(meeting.date)}</span>
                <span><a href={shared(itemUrl(item))} data-shared>{item.title}</a><br />
                <span class="small muted">{cityName(city, locale)} · {bodyName(meeting.body_id)}</span></span></li>
            ))}
          </ul>
        ) : <p class="empty">{t('city.empty')}</p>}
      </section>
      <aside>
        <h2>{t('home.upcoming')}</h2>
        {upcoming.length ? (
          <ul class="list">
            {upcoming.map(({ meeting, city }) => (
              <li><span class="date">{date(meeting.date)}</span>
                <a href={path(meetingUrl(meeting))}>{cityName(city, locale)}: {bodyName(meeting.body_id)}</a></li>
            ))}
          </ul>
        ) : <p class="muted">{t('common.none')}</p>}
        <p><a href={path('/kokoukset/')}>{t('home.allMeetings')}</a></p>
        <h2>{t('home.howTitle')}</h2>
        <p>{t('home.how')}</p>
        {locale !== 'fi' && <p class="small muted">{t('lang.docsNote')}</p>}
      </aside>
    </div>
  </div>
</Base>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-muni-filter]');
  const rows = [...document.querySelectorAll<HTMLLIElement>('[data-muni-list] li')];
  const empty = document.querySelector<HTMLElement>('[data-muni-empty]');
  const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  input?.addEventListener('input', () => {
    const q = fold(input.value.trim());
    let shown = 0;
    for (const li of rows) {
      const hit = !q || fold(li.dataset.name ?? '').includes(q);
      li.hidden = !hit;
      shown += hit ? 1 : 0;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
<style>
  .municipalities { margin-top: 2.5rem; }
  .filter input { width: 100%; max-width: 24rem; padding: .5rem .75rem; font: inherit; border: 1px solid var(--c-border, #ccc); border-radius: .4rem; background: var(--c-bg, transparent); color: inherit; }
  .muni-list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: .25rem 1.5rem; }
  .muni-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: .25rem .6rem; padding: .35rem 0; border-bottom: 1px solid var(--c-border, #e5e5e5); }
  .muni-list li[hidden] { display: none; }
  .muni-list a { font-weight: 600; }
</style>
