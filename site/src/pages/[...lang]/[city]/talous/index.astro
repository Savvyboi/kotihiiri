---
// A municipality's latest budget as an open book (/{city}/talous/, PLAN.md §19.1). Built for every
// municipality with budget data, followed or not, because the figures come from the State Treasury.
import BudgetBook from '../../../../components/BudgetBook.astro';
import { localized, type Locale } from '../../../../i18n';
import { cities, type City } from '../../../../lib/data';
import { budget, type BudgetFile } from '../../../../lib/budget';

export function getStaticPaths() {
  return localized(cities().filter((c) => budget(c.id)).map((city) => ({ params: { city: city.id }, props: { city, data: budget(city.id)! } })));
}
interface Props { city: City; data: BudgetFile; locale: Locale }
const { city, data, locale } = Astro.props;
---
<BudgetBook city={city} data={data} y={data.years[0]} locale={locale} />
