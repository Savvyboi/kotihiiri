---
import Base from '../../../../../layouts/Base.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import SourceLink from '../../../../../components/SourceLink.astro';
import { localized, useI18n, type Locale } from '../../../../../i18n';
import { cities, meetingFiles, bodyName, bodySlug, meetingSegment, itemUrl, cityName, decisionText, type AgendaItem, type City, type MeetingFile } from '../../../../../lib/data';
import { decisionOutcome, leadText, isProcedural } from '../../../../../lib/structure';
import { displayName, findPerson, personUrl } from '../../../../../lib/people';

export function getStaticPaths() {
  return localized(cities().flatMap((city) => meetingFiles(city.id).map((file) => ({
    params: { city: city.id, body: bodySlug(file.meeting.body_id), meeting: meetingSegment(file.meeting.id) },
    props: { city, file },
  }))));
}
interface Props { city: City; file: MeetingFile; locale: Locale }
const { city, file, locale } = Astro.props;
const { t, shared, date: fmt } = useI18n(locale);
const { meeting, items } = file;
const body = bodyName(meeting.body_id);
const date = fmt(meeting.date);
const present = meeting.attendance.filter((a) => a.present);
// printed name → link to the person's page, when the roster knows them
const who = (raw: string) => { const p = findPerson(city.id, raw); return { name: p?.name ?? displayName(raw), href: p && shared(personUrl(p)) }; };
const absent = meeting.attendance.filter((a) => !a.present);
const name = cityName(city, locale);
// Agenda cards: what was decided, in a line or two; the formalities every meeting opens with fold away.
const card = (item: AgendaItem) => {
  const decision = decisionText(item);
  const proposal = item.sections.find((s) => s.type === 'proposal')?.text;
  // `preview` is the AI brief's one-liner when there is one (lib/briefs.ts), else the decision,
  // else (agendas) the proposal.
  const preview = decision ? leadText(decision, 260) : proposal ? leadText(proposal, 260) : undefined;
  return { item, outcome: decisionOutcome(decision), preview, proposed: !decision && !!proposal, href: shared(itemUrl(item)) };
};
const formal = items.filter((i) => isProcedural(i.title) && !i.votes.length).map(card);
const rest = items.filter((i) => !isProcedural(i.title) || i.votes.length).map(card);
const nVotes = items.reduce((n, i) => n + i.votes.length, 0);
const nDecided = items.filter((i) => decisionText(i)).length;
---
<Base title={`${body} ${date} · ${name}`} city={city.id} locale={locale}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumb locale={locale} items={[
        { label: name, href: `/${city.id}/` },
        { label: body, href: `/${city.id}/${bodySlug(meeting.body_id)}/` },
        { label: date },
      ]} />
      <p class="eyebrow">{body}</p>
      <h1>{t('meeting.title', { date })}</h1>
      <ul class="meta">
        <li><span class="badge">{t(`meeting.stage.${meeting.stage}` as 'meeting.stage.agenda')}</span></li>
        {meeting.start_time && <li>{t('meeting.time')}: {meeting.start_time}{meeting.end_time && `–${meeting.end_time}`}</li>}
        {meeting.location && <li>{t('meeting.place')}: {meeting.location}</li>}
      </ul>
    </div>
  </section>
  <div class="wrap two-col">
    <section>
      {meeting.stage === 'agenda' && <p class="empty" style="margin-top:1.5rem">{t('meeting.agendaNotice')}</p>}
      <ul class="stats-row" aria-label={t('meeting.items')}>
        <li><b>{items.length}</b> {t('meeting.statItems')}</li>
        {nDecided > 0 && <li><b>{nDecided}</b> {t('meeting.statDecided')}</li>}
        {nVotes > 0 && <li><b>{nVotes}</b> {t('meeting.statVotes')}</li>}
      </ul>

      {/* AI brief: <AiBrief> goes here, above the agenda. */}

      <h2>{t('meeting.items')}</h2>
      {locale !== 'fi' && <p class="small muted">{t('lang.docsNote')}</p>}
      <div class="agenda-tools" data-agenda-tools hidden>
        <input type="search" data-agenda-q placeholder={t('meeting.search')} aria-label={t('meeting.search')} />
        {nVotes > 0 && <label class="check"><input type="checkbox" data-agenda-votes /> {t('meeting.onlyVotes')}</label>}
        <p class="small muted" role="status" data-agenda-status data-tpl={t('meeting.shown')} data-none={t('meeting.noMatch')}></p>
      </div>
      {formal.length > 0 && (
        <details class="formal">
          <summary>{t('meeting.procedural', { n: formal.length })}</summary>
          <ul class="list">{formal.map(({ item, href }) => (
            <li><span class="pykala">{item.pykala ? `${item.pykala} §` : `${item.ordinal}.`}</span><a href={href} data-shared>{item.title}</a></li>
          ))}</ul>
        </details>
      )}
      <ol class="agenda" data-agenda>
        {rest.map(({ item, outcome, preview, proposed, href }) => (
          <li class="agenda-item" data-votes={item.votes.length || undefined}>
            <span class="pykala">{item.pykala ? `${item.pykala} §` : `${item.ordinal}.`}</span>
            <div class="agenda-body">
              <h3><a href={href} data-shared>{item.title}</a></h3>
              <p class="agenda-tags">
                {outcome && outcome !== 'other' && <span class={`badge dec dec-${outcome}`}>{t(`dec.${outcome}` as 'dec.other')}</span>}
                {item.votes.length > 0 && <span class="badge vote-n">{t('item.votes')} {item.votes.length}</span>}
                {item.motions.length > 0 && <span class="badge">{t('item.motions')} {item.motions.length}</span>}
              </p>
              {preview && <p class="agenda-preview" lang="fi">{proposed && <b>{t('section.proposal')}: </b>}{preview}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
    <aside>
      {(meeting.video_url || meeting.minutes_pdf_url) && <h2>{t('city.source')}</h2>}
      {meeting.video_url && <p><a href={meeting.video_url} rel="external noopener">{t('meeting.video')}</a></p>}
      {meeting.minutes_pdf_url && <p><a href={meeting.minutes_pdf_url} rel="external noopener">{t('meeting.minutesPdf')}</a></p>}
      {meeting.stage === 'minutes' && meeting.attendance.length > 0 && <>
        <h2>{t('meeting.attendance')}</h2>
        <details open={present.length <= 15}><summary>{t('meeting.present')} ({present.length})</summary>
          <ul class="small attendees">{present.map((a) => <li>{(({ name, href }) => href ? <a href={href} data-shared>{name}</a> : name)(who(a.person_ref.raw))} <span class="muted">{a.role_text}</span>{a.note && <span class="muted"> · {a.note}</span>}</li>)}</ul>
        </details>
        {absent.length > 0 && <details><summary>{t('meeting.absent')} ({absent.length})</summary>
          <ul class="small attendees">{absent.map((a) => <li>{(({ name, href }) => href ? <a href={href} data-shared>{name}</a> : name)(who(a.person_ref.raw))} <span class="muted">{a.role_text}</span></li>)}</ul>
        </details>}
      </>}
      <SourceLink href={meeting.source_url} system={city.source_name} locale={locale} />
    </aside>
  </div>
</Base>
