---
// Item pages are built once, at the Finnish path, and translated client-side for ?lang=sv|en
// (see sharedPath in src/i18n): three copies of every item would break the size budget (PLAN.md §13).
// Reading order: what was decided, how it was voted, what was said, then the paperwork, folded.
import Base from '../../../../../../layouts/Base.astro';
import Breadcrumb from '../../../../../../components/Breadcrumb.astro';
import SourceLink from '../../../../../../components/SourceLink.astro';
import VoteDetail from '../../../../../../components/VoteDetail.astro';
import Prose from '../../../../../../components/Prose.astro';
import AiBrief from '../../../../../../components/AiBrief.astro';
import { itemBrief, meetingBrief } from '../../../../../../lib/briefs';
import T from '../../../../../../components/T.astro';
import { formatDate, sharedPath, type Key, type Locale } from '../../../../../../i18n';
import { cities, meetingFiles, bodyName, bodySlug, meetingSegment, decisionText, speechExcerpt, speechesByItem, type AgendaItem, type City, type Meeting } from '../../../../../../lib/data';
import { displayName, findPerson, personUrl, speaker } from '../../../../../../lib/people';
import { decisionOutcome, excerpt, leadText, wordCount } from '../../../../../../lib/structure';

export function getStaticPaths() {
  return cities().flatMap((city) => meetingFiles(city.id).flatMap(({ meeting, items }) => items.map((item) => ({
    params: { lang: undefined, city: city.id, body: bodySlug(meeting.body_id), meeting: meetingSegment(meeting.id), ordinal: String(item.ordinal) },
    props: { city, meeting, item },
  }))));
}
interface Props { city: City; meeting: Meeting; item: AgendaItem }
const { city, meeting, item } = Astro.props;
const locale: Locale = 'fi';
const body = bodyName(meeting.body_id);
const date = formatDate(meeting.date);
const decision = decisionText(item);
const outcome = decisionOutcome(decision);
// The proposal leads the paperwork; long reasoning is folded behind "read the rest".
const order: Record<string, number> = { proposal: 0, deliberation: 1, statement: 2, dissent: 3, background: 4, other: 5 };
const main = item.sections.filter((s) => s.type !== 'history' && s.type !== 'decision')
  .map((s, i) => ({ s, i })).sort((a, b) => (order[a.s.type] ?? 9) - (order[b.s.type] ?? 9) || a.i - b.i).map(({ s }) => s);
const history = item.sections.filter((s) => s.type === 'history');
const words = item.sections.reduce((n, s) => n + wordCount(s.text), 0);
const minutes = Math.max(1, Math.round(words / 200));
const brief = itemBrief(item);
const briefMeta = brief && meetingBrief(meeting.id);
// printed name → link to the person's page, when the roster knows them
const who = (raw: string) => { const p = findPerson(city.id, raw); return { name: p?.name ?? displayName(raw), href: p && sharedPath(personUrl(p)) }; };
// Speeches from the council's debate transcript (M6), each collapsed; #puhe-N opens one.
const talk = (speechesByItem(city.id).get(item.id) ?? []).map((s) => {
  const p = speaker(city.id, s.speaker_ref);
  return { s, name: p?.name ?? s.speaker_ref.raw, href: p && sharedPath(personUrl(p)), paras: s.text.split(/\n{2,}/) };
});
const toc = [
  decision && { id: 'paatos', k: 'item.decision' },
  item.votes.length > 0 && { id: 'aanestykset', k: 'item.votes', n: item.votes.length },
  item.motions.length > 0 && !item.votes.length && { id: 'ehdotukset', k: 'item.motions', n: item.motions.length },
  talk.length > 0 && { id: 'keskustelu', k: 'item.speeches', n: talk.length },
  main.length > 0 && { id: 'valmistelu', k: 'item.sections' },
  history.length > 0 && { id: 'historia', k: 'section.history', n: history.length },
  item.attachments.length > 0 && { id: 'liitteet', k: 'item.attachments', n: item.attachments.length },
].filter(Boolean) as { id: string; k: Key; n?: number }[];
// Long attachment lists show the first few; the rest open on demand.
const ATT = 8;
---
<Base title={item.title} city={city.id} description={decision ? excerpt(decision, 160) : undefined} locale={locale} shared>
  <section class="hero">
    <div class="wrap">
      <Breadcrumb locale={locale} items={[
        { label: city.name_fi, href: `/${city.id}/` },
        { label: body, href: `/${city.id}/${bodySlug(meeting.body_id)}/` },
        { label: date, href: `/${city.id}/${bodySlug(meeting.body_id)}/${meetingSegment(meeting.id)}/` },
        { label: item.pykala ? `${item.pykala} §` : `${item.ordinal}.` },
      ]} />
      <p class="eyebrow">{body} · {date}</p>
      <h1 data-pagefind-meta="title" lang="fi">{item.title}</h1>
      <ul class="meta">
        {outcome && <li><span class={`badge dec dec-${outcome}`}><T k={`dec.${outcome}` as Key} locale={locale} /></span></li>}
        {item.case_number && <li><T k="item.caseNumber" locale={locale} />: {item.case_number}</li>}
        {item.presenter && <li><T k="item.presenter" locale={locale} />: {item.presenter}</li>}
        {words > 400 && <li><T k="item.readTime" vars={{ n: minutes }} locale={locale} /></li>}
      </ul>
      <p class="small muted" hidden data-locale-only><T k="lang.docsNote" locale={locale} /></p>
    </div>
  </section>
  <div class="wrap item-page" data-pagefind-body>
    <span hidden data-pagefind-filter="city">{city.name_fi}</span>
    <span hidden data-pagefind-filter="body">{body}</span>
    <span hidden data-pagefind-filter="year">{meeting.date.slice(0, 4)}</span>

    {toc.length > 2 && (
      <nav class="toc" aria-labelledby="toc-h" data-pagefind-ignore>
        <span id="toc-h" class="toc-h"><T k="item.toc" locale={locale} /></span>
        <ul>{toc.map((x) => <li><a href={`#${x.id}`}><T k={x.k} locale={locale} />{x.n !== undefined && <span class="n">{x.n}</span>}</a></li>)}</ul>
      </nav>
    )}

    {brief && briefMeta && <AiBrief text={brief.brief} model={briefMeta.model} lang={briefMeta.lang} locale={locale} />}

    {decision && (
      <section class="decision" id="paatos">
        <h2 style="margin-top:0"><T k="item.decision" locale={locale} /></h2>
        <Prose text={decision} locale={locale} fold={900} />
      </section>
    )}

    {item.motions.length > 0 && <>
      <h2 id="ehdotukset"><T k="item.motions" locale={locale} /></h2>
      {item.motions.map((m) => (
        <div class="card motion">
          <p class="small" style="margin:0 0 .3rem"><b><T k={`motion.${m.kind}` as 'motion.other'} locale={locale} /></b>
            {m.outcome && <> <span class:list={['badge', m.outcome]}><T k={`outcome.${m.outcome}` as 'outcome.unknown'} locale={locale} /></span></>}</p>
          <p class="prose" style="margin:0 0 .3rem" lang="fi">{m.text}</p>
          <p class="small muted" style="margin:0"><T k="item.proposer" locale={locale} />: {(({ name, href }) => href ? <a href={href} data-shared>{name}</a> : name)(who(m.proposer_ref.raw))}
            {m.seconder_refs?.length ? <> · <T k="item.seconders" locale={locale} />: {m.seconder_refs.map((s, i) => <>{i > 0 && ', '}{(({ name, href }) => href ? <a href={href} data-shared>{name}</a> : name)(who(s.raw))}</>)}</> : null}</p>
        </div>
      ))}
    </>}

    {item.votes.length > 0 && <>
      <h2 id="aanestykset"><T k="item.votes" locale={locale} /></h2>
      {item.votes.map((v) => <VoteDetail vote={v} city={city.id} locale={locale} compact={item.votes.length > 1} brief={brief?.votes?.[String(v.ordinal)]} model={briefMeta?.model} />)}
    </>}

    {talk.length > 0 && <>
      <h2 id="keskustelu"><T k="item.speeches" locale={locale} /></h2>
      <p class="small muted"><T k="item.speechesLead" vars={{ n: talk.length }} locale={locale} />
        {' '}<a href={talk[0].s.source_url} rel="external noopener"><T k="item.speechesSource" locale={locale} /></a></p>
      <div class="speeches" data-pagefind-ignore>
        {talk.map(({ s, name, href, paras }) => (
          <details id={`puhe-${s.ordinal}`} class="speech">
            <summary><span lang={s.lang}>{s.speaker_title}</span> {href ? <a href={href} data-shared>{name}</a> : name}
              {s.kind === 'reply' && <span class="small muted"> · <T k="speech.reply" locale={locale} /></span>}
              <span class="excerpt small muted" lang={s.lang}>{speechExcerpt(s.text, 140)}</span></summary>
            <div class="prose" lang={s.lang}>{paras.map((t) => <p>{t}</p>)}</div>
          </details>
        ))}
      </div>
    </>}

    {main.length > 0 && <section id="valmistelu" class="folds">
      <div class="folds-head">
        <h2><T k="item.sections" locale={locale} /></h2>
        {main.length > 1 && <button type="button" class="linkish" data-toggle-all hidden><span class="when-closed"><T k="item.openAll" locale={locale} /></span><span class="when-open"><T k="item.closeAll" locale={locale} /></span></button>}
      </div>
      {main.map((s, i) => {
        const short = s.text.length < 700;
        const lead = i === 0 && !main.some((x) => x.type === 'proposal' || x.text.length < 700);
        return (
          <details class="fold" open={lead || short || s.type === 'proposal'} lang="fi">
            <summary><span class="fold-h">{s.heading ?? <T k={`section.${s.type}` as 'section.other'} locale={locale} />}</span>
              {!short && <span class="fold-n small muted"><T k="item.readTime" vars={{ n: Math.max(1, Math.round(wordCount(s.text) / 200)) }} locale={locale} /></span>}
              {!short && <span class="fold-x small muted">{leadText(s.text, 160)}</span>}</summary>
            <Prose text={s.text} locale={locale} fold={lead ? 1200 : 0} />
          </details>
        );
      })}
    </section>}

    {history.length > 0 && (
      <section id="historia" data-pagefind-ignore>
        <h2><T k="section.history" locale={locale} /></h2>
        <p class="small muted"><T k="item.historyLead" vars={{ n: history.length }} locale={locale} /></p>
        <ol class="timeline" lang="fi">
          {history.map((s) => (
            <li><details class="fold">
              <summary><span class="fold-h">{s.heading ?? '—'}</span><span class="fold-x small muted">{leadText(s.text, 140)}</span></summary>
              <Prose text={s.text} locale={locale} />
            </details></li>
          ))}
        </ol>
      </section>
    )}

    {item.attachments.length > 0 && <section id="liitteet">
      <h2><T k="item.attachments" locale={locale} /> <span class="muted small">({item.attachments.length})</span></h2>
      <ol class="attachments" lang="fi">{item.attachments.slice(0, ATT).map((a) => <li><a href={a.url} rel="external noopener">{a.title}</a></li>)}</ol>
      {item.attachments.length > ATT && <details class="more plain"><summary><span class="more-open"><T k="item.moreAttachments" vars={{ n: item.attachments.length - ATT }} locale={locale} /></span><span class="more-close"><T k="prose.less" locale={locale} /></span></summary>
        <ol class="attachments" start={ATT + 1} lang="fi">{item.attachments.slice(ATT).map((a) => <li><a href={a.url} rel="external noopener">{a.title}</a></li>)}</ol>
      </details>}
    </section>}

    <SourceLink href={item.source_url} system={city.source_name} locale={locale} />
  </div>
</Base>
