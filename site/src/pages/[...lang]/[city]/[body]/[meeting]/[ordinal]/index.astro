---
import Base from '../../../../../layouts/Base.astro';
import Breadcrumb from '../../../../../components/Breadcrumb.astro';
import SourceLink from '../../../../../components/SourceLink.astro';
import VoteDetail from '../../../../../components/VoteDetail.astro';
import { t, formatDate } from '../../../../../i18n';
import { cities, meetingFiles, bodyName, bodySlug, meetingSegment, decisionText, type AgendaItem, type City, type Meeting } from '../../../../../lib/data';

export function getStaticPaths() {
  return cities().flatMap((city) => meetingFiles(city.id).flatMap(({ meeting, items }) => items.map((item) => ({
    params: { city: city.id, body: bodySlug(meeting.body_id), meeting: meetingSegment(meeting.id), ordinal: String(item.ordinal) },
    props: { city, meeting, item },
  }))));
}
interface Props { city: City; meeting: Meeting; item: AgendaItem }
const { city, meeting, item } = Astro.props;
const body = bodyName(meeting.body_id);
const date = formatDate(meeting.date);
const decision = decisionText(item);
const main = item.sections.filter((s) => s.type !== 'history' && s.type !== 'decision');
const history = item.sections.filter((s) => s.type === 'history');
---
<Base title={item.title} city={city.id} description={decision?.slice(0, 160)}>
  <section class="hero">
    <div class="wrap">
      <Breadcrumb items={[
        { label: city.name_fi, href: `/${city.id}/` },
        { label: body, href: `/${city.id}/${bodySlug(meeting.body_id)}/` },
        { label: date, href: `/${city.id}/${bodySlug(meeting.body_id)}/${meetingSegment(meeting.id)}/` },
        { label: item.pykala ? `${item.pykala} §` : `${item.ordinal}.` },
      ]} />
      <p class="eyebrow">{body} · {date}</p>
      <h1 data-pagefind-meta="title">{item.title}</h1>
      <ul class="meta">
        {item.case_number && <li>{t('item.caseNumber')}: {item.case_number}</li>}
        {item.presenter && <li>{t('item.presenter')}: {item.presenter}</li>}
      </ul>
    </div>
  </section>
  <div class="wrap" data-pagefind-body>
    <span hidden data-pagefind-filter="city">{city.name_fi}</span>
    <span hidden data-pagefind-filter="body">{body}</span>
    <span hidden data-pagefind-filter="year">{meeting.date.slice(0, 4)}</span>
    {decision && <div class="decision"><h2 style="margin-top:0">{t('item.decision')}</h2><p class="prose">{decision}</p></div>}

    {item.motions.length > 0 && <>
      <h2>{t('item.motions')}</h2>
      {item.motions.map((m) => (
        <div class="card" style="margin-bottom:.8rem">
          <p class="small" style="margin:0 0 .3rem"><b>{t(`motion.${m.kind}`)}</b>
            {m.outcome && <> <span class:list={['badge', m.outcome]}>{t(`outcome.${m.outcome}`)}</span></>}</p>
          <p class="prose" style="margin:0 0 .3rem">{m.text}</p>
          <p class="small muted" style="margin:0">{t('item.proposer')}: {m.proposer_ref.raw}
            {m.seconder_refs?.length ? <> · {t('item.seconders')}: {m.seconder_refs.map((s) => s.raw).join(', ')}</> : null}</p>
        </div>
      ))}
    </>}

    {item.votes.length > 0 && <>
      <h2>{t('item.votes')}</h2>
      {item.votes.map((v) => <VoteDetail vote={v} />)}
    </>}

    {main.length > 0 && <h2>{t('item.sections')}</h2>}
    {main.map((s) => (
      <section>
        <h3 style="margin-top:1.2rem">{s.heading ?? t(`section.${s.type}`)}</h3>
        <p class="prose">{s.text}</p>
      </section>
    ))}

    {history.length > 0 && (
      <details data-pagefind-ignore>
        <summary>{t('item.history')}</summary>
        {history.map((s) => <><h3 style="margin-top:1rem">{s.heading}</h3><p class="prose">{s.text}</p></>)}
      </details>
    )}

    {item.attachments.length > 0 && <>
      <h2>{t('item.attachments')}</h2>
      <ul>{item.attachments.map((a) => <li><a href={a.url} rel="external noopener">{a.title}</a></li>)}</ul>
    </>}

    <SourceLink href={item.source_url} system={city.source_name} />
  </div>
</Base>
