---
// Parties across every municipality (/puolueet/): council seats, how often each party's side wins,
// how united its members vote, and which parties vote the same way.
import Base from '../../layouts/Base.astro';
import { localeParams, useI18n, type Locale } from '../../i18n';
import { NAMED_PARTIES, pairKey, partyView } from '../../lib/national';
import { PARTY_ABBR, PARTY_COLOURS, partyKey, type Party } from '../../lib/parties';

export function getStaticPaths() {
  return localeParams().map(({ lang, locale }) => ({ params: { lang }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, num } = useI18n(locale);
const view = partyView();
const pct = (a: number, b: number) => (b ? Math.round((100 * a) / b) : undefined);
const stats = view.stats.filter((s) => s.seats || s.positions)
  .sort((a, b) => b.seats - a.seats || b.positions - a.positions);
const shown = stats.filter((s) => s.positions >= 20).map((s) => s.party);
const matrix = NAMED_PARTIES.filter((p) => shown.includes(p));
const pair = (a: Party, b: Party) => {
  const [x, y] = NAMED_PARTIES.indexOf(a) < NAMED_PARTIES.indexOf(b) ? [a, b] : [b, a];
  return view.pairs.get(pairKey(x, y));
};
const MIN_SHARED = 10;
/** For each party, every other party it shared at least MIN_SHARED votes with, most alike first. */
const allies = stats.filter((s) => shown.includes(s.party)).map((s) => ({
  party: s.party,
  others: matrix.filter((o) => o !== s.party).map((o) => {
    const pr = pair(s.party, o);
    return pr && pr.both >= MIN_SHARED ? { party: o, p: pct(pr.same, pr.both)!, n: pr.both } : undefined;
  }).filter((x): x is { party: Party; p: number; n: number } => !!x).sort((a, b) => b.p - a.p || b.n - a.n),
}));
const name = (p: Party) => t(partyKey(p));
---
<Base title={t('parties.pageTitle')} locale={locale}>
  <section class="hero">
    <div class="wrap">
      <h1>{t('parties.pageTitle')}</h1>
      <p class="lead">{t('parties.lead')}</p>
    </div>
  </section>
  <div class="wrap">
    <h2>{t('parties.table.title')}</h2>
    <div class="table-scroll">
      <table class="party-table">
        <thead><tr>
          <th>{t('parties.col.party')}</th>
          <th class="num">{t('parties.col.seats')}</th>
          <th class="num">{t('parties.col.positions')}</th>
          <th class="num">{t('parties.col.wins')}</th>
          <th class="num">{t('parties.col.cohesion')}</th>
        </tr></thead>
        <tbody>
          {stats.map((s) => {
            const wins = pct(s.wins, s.positions);
            const coh = pct(s.together, s.cast);
            return (
              <tr>
                <th scope="row"><i class="party-dot" style={`background:${PARTY_COLOURS[s.party]}`} />{name(s.party)}</th>
                <td class="num">{num(s.seats)}<span class="small muted"> · {t('parties.inMunis', { n: num(s.munis) })}</span></td>
                <td class="num">{num(s.positions)}</td>
                <td class="num">{wins === undefined ? '–' : <><span class="meter" style={`--v:${wins}%`} />{wins} %</>}</td>
                <td class="num">{coh === undefined ? '–' : <><span class="meter" style={`--v:${coh}%`} />{coh} %</>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    <dl class="party-help small">
      <div><dt>{t('parties.col.seats')}</dt><dd>{t('parties.help.seats')}</dd></div>
      <div><dt>{t('parties.col.positions')}</dt><dd>{t('parties.help.positions')}</dd></div>
      <div><dt>{t('parties.col.wins')}</dt><dd>{t('parties.help.wins')}</dd></div>
      <div><dt>{t('parties.col.cohesion')}</dt><dd>{t('parties.help.cohesion')}</dd></div>
    </dl>

    {allies.length > 1 && (
      <section>
        <h2>{t('parties.agree.title')}</h2>
        <p class="muted">{t('parties.agree.lead')}</p>
        <div class="grid ally-grid">
          {allies.map((a) => (
            <article class="card ally-card" style={`--party:${PARTY_COLOURS[a.party]}`}>
              <h3><i class="party-dot" style={`background:${PARTY_COLOURS[a.party]}`} />{name(a.party)}</h3>
              <p class="small muted">{t('parties.agree.cardLead', { party: name(a.party) })}</p>
              <ol class="ally-bars">
                {a.others.map((o) => (
                  <li title={t('parties.agree.cell', { a: name(a.party), b: name(o.party), p: o.p, n: num(o.n) })}>
                    <span class="ab-name">{name(o.party)}</span>
                    <span class="ab-bar"><i style={`width:${o.p}%;background:${PARTY_COLOURS[o.party]}`} /></span>
                    <span class="ab-p">{o.p} %</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
        <details class="agree-table">
          <summary>{t('parties.agree.asTable')}</summary>
          <div class="table-scroll">
            <table class="agree-matrix">
              <thead><tr><th />{matrix.map((p) => <th scope="col"><abbr title={name(p)}>{PARTY_ABBR[p]}</abbr></th>)}</tr></thead>
              <tbody>
                {matrix.map((a) => (
                  <tr>
                    <th scope="row"><abbr title={name(a)}>{PARTY_ABBR[a]}</abbr></th>
                    {matrix.map((b) => {
                      if (a === b) return <td class="self" />;
                      const pr = pair(a, b);
                      const p = pr && pr.both >= MIN_SHARED ? pct(pr.same, pr.both) : undefined;
                      return p === undefined ? <td class="none">–</td> : (
                        <td class={p >= 60 ? 'dark' : undefined} style={`--v:${p / 100}`} title={t('parties.agree.cell', { a: name(a), b: name(b), p, n: num(pr!.both) })}>{p}</td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    )}
    <p class="small muted" style="margin-top:2rem">{t('parties.note', { votes: num(view.votes), munis: num(view.munis) })}</p>
  </div>
</Base>
