---
// Map of Finland's municipalities (/kartta/); the map itself is components/MunicipalityMap.astro.
import Base from '../../layouts/Base.astro';
import MunicipalityMap from '../../components/MunicipalityMap.astro';
import { localeParams, useI18n, type Locale } from '../../i18n';
import { cities } from '../../lib/data';
import { MUNICIPALITY_MAP as MAP } from '../../lib/map';

export function getStaticPaths() {
  return localeParams().map(({ lang, locale }) => ({ params: { lang }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, num } = useI18n(locale);
const followed = new Set(cities().filter((c) => c.enabled).map((c) => c.id));
const n = MAP ? MAP.municipalities.filter((s) => s.id && followed.has(s.id)).length : 0;
const lead = MAP ? t('map.lead', { n: num(n), all: num(MAP.municipalities.length) }) : undefined;
---
<Base title={t('map.title')} description={lead} locale={locale}>
  <section class="hero">
    <div class="wrap">
      <h1>{t('map.title')}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </section>
  <div class="wrap">
    <MunicipalityMap locale={locale} />
  </div>
</Base>
