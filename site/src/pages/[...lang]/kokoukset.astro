---
// Every meeting in every municipality: upcoming agendas first, then one table to filter by
// municipality, body type, stage, date and body name. Without JavaScript the newest meetings are
// listed; the script loads the rest from /kokoukset.json.
import Base from '../../layouts/Base.astro';
import { assetPath, localeParams, localePath, useI18n, type Key, type Locale } from '../../i18n';
import { city as cityRec, cityName } from '../../lib/data';
import { allMeetingRows } from '../../lib/national';

export function getStaticPaths() {
  return localeParams().map(({ lang, locale }) => ({ params: { lang }, props: { locale } }));
}
interface Props { locale: Locale }
const { locale } = Astro.props;
const { t, date, num, path } = useI18n(locale);

const rows = allMeetingRows();
const FIRST = 100;
const today = new Date().toISOString().slice(0, 10);
const upcoming = rows.filter((r) => r.s === 'agenda' && r.d >= today)
  .sort((a, b) => a.d.localeCompare(b.d) || a.h.localeCompare(b.h) || a.c.localeCompare(b.c)).slice(0, 30);
const muniIds = [...new Set(rows.map((r) => r.c))];
const munis = muniIds.map((id) => ({ id, name: cityName(cityRec(id)!, locale) })).sort((a, b) => a.name.localeCompare(b.name, locale));
const names = Object.fromEntries(munis.map((m) => [m.id, m.name]));
const kinds = ['council', 'board', 'committee', 'section', 'enterprise_board'].filter((k) => rows.some((r) => r.k === k));
const stages = ['agenda', 'decisions', 'minutes'].filter((s) => rows.some((r) => r.s === s));
const stageNames = Object.fromEntries(stages.map((s) => [s, t(`meeting.stage.${s}` as Key)]));
const i18n = { shown: t('meetings.shown', { n: '{n}' }) };
const lang = locale;
const dateTpl = t('common.date');
const json = assetPath('/kokoukset.json');
const prefix = localePath('/').replace(/\/$/, '');
---
<Base title={t('meetings.title')} locale={locale} feed="/syote.xml">
  <section class="hero">
    <div class="wrap">
      <h1>{t('meetings.title')}</h1>
      <p class="lead">{t('meetings.lead')}</p>
      <p class="feed-link small"><a href={assetPath('/syote.xml')}><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><circle cx="3" cy="13" r="2" fill="currentColor"/><path d="M1 7a8 8 0 0 1 8 8M1 2a13 13 0 0 1 13 13" stroke="currentColor" stroke-width="2.2" fill="none"/></svg>{t('feed.link')}</a> <span class="muted">{t('feed.lead')}</span></p>
    </div>
  </section>
  <div class="wrap">
    <h2>{t('meetings.upcoming')}</h2>
    {upcoming.length ? (
      <ul class="list">
        {upcoming.map((r) => (
          <li><span class="date">{date(r.d)}{r.h ? `\u00a0${r.h}` : ''}</span>
            <span><a href={path(r.u)}>{names[r.c]}: {r.b}</a>
            {r.n > 0 && <span class="small muted"> · {t('topics.count', { n: num(r.n) })}</span>}</span></li>
        ))}
      </ul>
    ) : <p class="muted">{t('meetings.noUpcoming')}</p>}

    <h2>{t('meetings.all')}</h2>
    <form class="vote-filters" aria-label={t('votes.filters')} hidden data-filters>
      <label>{t('allVotes.muni')}
        <select name="kunta">
          <option value="">{t('votes.all')}</option>
          {munis.map((m) => <option value={m.id}>{m.name}</option>)}
        </select>
      </label>
      <label>{t('allVotes.kind')}
        <select name="tyyppi">
          <option value="">{t('votes.all')}</option>
          {kinds.map((k) => <option value={k}>{t(`body.kind.${k}` as Key)}</option>)}
        </select>
      </label>
      <label>{t('meetings.stage')}
        <select name="vaihe">
          <option value="">{t('votes.all')}</option>
          {stages.map((s) => <option value={s}>{stageNames[s]}</option>)}
        </select>
      </label>
      <label>{t('allVotes.from')}<input type="date" name="alkaen" /></label>
      <label>{t('allVotes.to')}<input type="date" name="asti" /></label>
      <label>{t('meetings.q')}<input type="search" name="q" autocomplete="off" /></label>
      <p class="small"><a href={json} download="kokoukset.json">JSON</a></p>
    </form>
    <p class="small muted" aria-live="polite" data-count>{t('meetings.shown', { n: num(rows.length) })}</p>
    <div class="table-scroll">
      <table class="all-votes all-meetings">
        <thead><tr>
          <th>{t('allVotes.col.date')}</th><th>{t('allVotes.muni')}</th><th>{t('votes.body')}</th>
          <th>{t('meetings.stage')}</th><th class="num">{t('meetings.col.items')}</th><th class="num">{t('meetings.col.votes')}</th>
        </tr></thead>
        <tbody data-rows>
          {rows.slice(0, FIRST).map((r) => (
            <tr>
              <td>{date(r.d)}</td><td>{names[r.c]}</td><td><a href={path(r.u)}>{r.b}</a></td>
              <td>{stageNames[r.s]}</td><td class="num">{r.n}</td><td class="num">{r.v || ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty" hidden data-nomatch>{t('meetings.none')}</p>
    <p><button type="button" class="more" hidden data-more>{t('allVotes.more')}</button></p>
  </div>
  <script is:inline define:vars={{ json, prefix, dateTpl, i18n, names, stageNames, lang, FIRST }}>
    (async () => {
      const form = document.querySelector('[data-filters]');
      const body = document.querySelector('[data-rows]');
      if (!form || !body) return;
      let rows;
      try { rows = await (await fetch(json)).json(); } catch { return; }
      form.hidden = false;
      const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const fmt = (iso) => { const [y, m, d] = iso.split('-').map(Number);
        return dateTpl.replace('{d}', d).replace('{m}', m).replace('{y}', y).replace('{mon}', MON[m - 1]); };
      const nf = new Intl.NumberFormat(lang === 'en' ? 'en-GB' : `${lang}-FI`);
      const href = (u) => `${prefix}${lang === 'fi' ? '' : `/${lang}`}${u}`;
      const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const keys = ['kunta', 'tyyppi', 'vaihe', 'alkaen', 'asti', 'q'];
      const params = new URLSearchParams(location.search);
      for (const k of keys) if (params.get(k)) form.elements[k].value = params.get(k);
      let shown = FIRST, current = [];
      const row = (r) => `<tr><td>${fmt(r.d)}</td><td>${esc(names[r.c] ?? r.c)}</td><td><a href="${esc(href(r.u))}">${esc(r.b)}</a></td>`
        + `<td>${esc(stageNames[r.s] ?? r.s)}</td><td class="num">${r.n}</td><td class="num">${r.v || ''}</td></tr>`;
      const render = () => {
        body.innerHTML = current.slice(0, shown).map(row).join('');
        document.querySelector('[data-more]').hidden = current.length <= shown;
        document.querySelector('[data-nomatch]').hidden = current.length > 0;
        document.querySelector('[data-count]').textContent = i18n.shown.replace('{n}', nf.format(current.length));
      };
      const apply = () => {
        const v = Object.fromEntries(keys.map((k) => [k, form.elements[k].value.trim()]));
        const words = v.q.toLowerCase().split(/\s+/).filter(Boolean);
        current = rows.filter((r) => (!v.kunta || r.c === v.kunta) && (!v.tyyppi || r.k === v.tyyppi)
          && (!v.vaihe || r.s === v.vaihe) && (!v.alkaen || r.d >= v.alkaen) && (!v.asti || r.d <= v.asti)
          && words.every((w) => r.b.toLowerCase().includes(w)));
        shown = FIRST;
        render();
        const q = new URLSearchParams();
        for (const k of keys) if (v[k]) q.set(k, v[k]);
        history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
      };
      form.addEventListener('input', apply);
      form.addEventListener('submit', (e) => e.preventDefault());
      document.querySelector('[data-more]').addEventListener('click', () => { shown += FIRST; render(); });
      apply();
    })();
  </script>
</Base>
