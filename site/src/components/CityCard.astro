---
import { t, localePath, assetPath, formatNumber, type Locale } from '../i18n';
import { cityStats, cityName, disabledKey, type City } from '../lib/data';
import { cityImages } from '../lib/images';
interface Props { city: City; locale: Locale }
const { city, locale } = Astro.props;
const s = cityStats(city.id);
const img = cityImages(city.id);
const name = cityName(city, locale);
---
<article class:list={['card', 'linked', 'city-card', { off: !city.enabled }]} data-city={city.id}>
  <div class="band">
    {img.photo && <img class="band-photo" src={assetPath(`/images/cities/${img.photo.files[1]}`)} alt="" loading="lazy" decoding="async" />}
    {img.arms && <img class="arms" src={assetPath(`/images/cities/${img.arms.files[0]}`)} alt={t('city.arms', { city: name }, locale)} width="44" height="52" loading="lazy" />}
    <h3><a class="stretch" href={localePath(`/${city.id}/`, locale)}>{name}</a></h3>
  </div>
  <div class="body">
    {city.enabled
      ? <p class="small" style="margin:0"><span class="badge on">{t('city.enabled', {}, locale)}</span> {formatNumber(s.meetings, locale)} {t('city.stats.meetings', {}, locale)} · {formatNumber(s.votes, locale)} {t('city.stats.votes', {}, locale)}</p>
      : <p class="small" style="margin:0"><span class="badge">{t(disabledKey(city), {}, locale)}</span></p>}
  </div>
</article>
