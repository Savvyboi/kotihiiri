---
// Map of Finland's municipalities (on /kartta/ and the home page): followed municipalities link to their pages, the ones
// on the list but not followed yet are marked, and the rest are drawn for context. Boundaries are
// Statistics Finland's (src/lib/map.ts). The map is plain SVG with links and works without
// JavaScript; the script only adds a label that follows the pointer or keyboard focus.
import { useI18n, type Locale } from '../i18n';
import { cities, cityName, cityStats, disabledKey } from '../lib/data';
import { MUNICIPALITY_MAP as MAP, shapeName, type MapShape } from '../lib/map';

interface Props { locale: Locale; /** Map above its legend and inset, for a narrow column (home page). */ compact?: boolean }
const { locale, compact = false } = Astro.props;
const { t, num, path } = useI18n(locale);

const byId = new Map(cities().map((c) => [c.id, c]));
type Status = 'followed' | 'pending' | 'other';
const statusOf = (s: MapShape): Status => {
  const c = s.id ? byId.get(s.id) : undefined;
  return !c ? 'other' : c.enabled ? 'followed' : 'pending';
};
/** One line under the name in the label: what we have for this municipality. */
const detail = (s: MapShape): string => {
  const c = s.id ? byId.get(s.id) : undefined;
  if (!c) return t('map.notListed');
  if (!c.enabled) return t(disabledKey(c));
  const st = cityStats(c.id);
  return [`${num(st.meetings)} ${t('city.stats.meetings')}`, st.votes ? `${num(st.votes)} ${t('home.stats.votes')}` : '']
    .filter(Boolean).join(' · ');
};
const name = (s: MapShape) => {
  const c = s.id ? byId.get(s.id) : undefined;
  return c ? cityName(c, locale) : shapeName(s, locale);
};
const counts = MAP
  ? (['followed', 'pending', 'other'] as Status[]).map((k) => ({ k, n: MAP.municipalities.filter((s) => statusOf(s) === k).length }))
  : [];
const box = (v: number[]) => v.join(' ');
/** Inset label x, nudged so a long name near the edge (Kirkkonummi) stays inside the frame. */
const labelX = (s: MapShape) => {
  const [x0, , w] = MAP!.inset!.viewbox;
  const half = (name(s).length * (statusOf(s) === 'followed' ? 24 : 18) * 0.62) / 2 + 4;
  return Math.round(Math.min(Math.max(s.label![0], x0 + half), x0 + w - half));
};
---
<div class="map-block">
{MAP ? (
  <div class:list={['muni-map', { compact }]}>
    <figure class="map-main">
      <svg viewBox={box(MAP.viewbox)} role="group" aria-label={t('map.title')} data-map>
        {MAP.municipalities.map((s) => {
          const st = statusOf(s);
          const shape = <path d={s.d} class={`m-${st}`} data-name={name(s)} data-detail={detail(s)}><title>{name(s)}: {detail(s)}</title></path>;
          return st === 'other' ? shape : <a href={path(`/${s.id}/`)} aria-label={`${name(s)}: ${detail(s)}`}>{shape}</a>;
        })}
        {MAP.inset && <rect class="inset-frame" x={MAP.inset.viewbox[0]} y={MAP.inset.viewbox[1]} width={MAP.inset.viewbox[2]} height={MAP.inset.viewbox[3]} aria-hidden="true" />}
      </svg>
    </figure>
    <div class="map-side">
      <ul class="map-legend">
        {counts.map(({ k, n }) => <li><span class={`swatch m-${k}`} aria-hidden="true"></span>{t(`map.legend.${k}`)} <span class="muted">{num(n)}</span></li>)}
      </ul>
      {MAP.inset && (
        <figure class="map-inset">
          <svg viewBox={box(MAP.inset.viewbox)} role="group" aria-label={t('map.inset')} data-map>
            {MAP.inset.municipalities.map((s) => {
              const st = statusOf(s);
              const shape = <path d={s.d} class={`m-${st}`} data-name={name(s)} data-detail={detail(s)}><title>{name(s)}: {detail(s)}</title></path>;
              // The inset repeats links from the main map; keep it out of the tab order.
              return st === 'other' ? shape : <a href={path(`/${s.id}/`)} tabindex="-1" aria-hidden="true">{shape}</a>;
            })}
            {MAP.inset.municipalities.filter((s) => s.label && statusOf(s) !== 'other').map((s) => (
              <text x={labelX(s)} y={s.label![1]} class={`lbl lbl-${statusOf(s)}`} aria-hidden="true">{name(s)}</text>
            ))}
          </svg>
          <figcaption class="small muted">{t('map.inset')}</figcaption>
        </figure>
      )}
      <p class="map-label" data-map-label aria-hidden="true" hidden><b></b><span class="small muted"></span></p>
    </div>
  </div>
) : <p class="empty">{t('map.missing')}</p>}
{MAP && (
  <p class="small muted map-source">
    {t('map.source', { year: MAP.year })} <a href="https://stat.fi/org/avoindata/paikkatietoaineistot/tilastoalueet.html">Tilastokeskus</a>, {MAP.licence}.
    {!compact && <>{' '}<a href={path('/#kunnat')}>{t('map.list')}</a></>}
  </p>
)}

</div>
<script>
  // A label beside the map with the name and status of the municipality under the pointer or focus.
  const label = document.querySelector<HTMLElement>('[data-map-label]');
  if (label) {
    const [nameEl, detailEl] = [label.querySelector('b')!, label.querySelector('span')!];
    let current: Element | null = null;
    const show = (p: Element | null) => {
      if (p === current) return;
      current?.classList.remove('hover');
      current = p;
      if (!p) { label.hidden = true; return; }
      p.classList.add('hover');
      nameEl.textContent = (p as HTMLElement).dataset.name ?? '';
      detailEl.textContent = (p as HTMLElement).dataset.detail ?? '';
      label.hidden = false;
    };
    for (const svg of document.querySelectorAll('[data-map]')) {
      svg.addEventListener('pointerover', (e) => show((e.target as Element).closest('path')));
      svg.addEventListener('pointerleave', () => show(null));
      svg.addEventListener('focusin', (e) => show((e.target as Element).querySelector('path')));
      svg.addEventListener('focusout', () => show(null));
    }
  }
</script>
<style>
  .muni-map {
    --m-on: var(--c-primary); --m-on-text: var(--c-on-primary);
    --m-pending: color-mix(in srgb, var(--c-primary) 32%, var(--c-bg));
    --m-pending-hover: color-mix(in srgb, var(--c-primary) 55%, var(--c-bg));
    --m-other: color-mix(in srgb, var(--c-muted) 18%, var(--c-bg));
    --m-other-hover: color-mix(in srgb, var(--c-muted) 35%, var(--c-bg));
  }
  @media (prefers-color-scheme: dark) {
    .muni-map {
      --m-on: var(--c-link); --m-on-text: var(--c-bg);
      --m-pending: color-mix(in srgb, var(--c-link) 30%, var(--c-bg));
      --m-pending-hover: color-mix(in srgb, var(--c-link) 50%, var(--c-bg));
      --m-other: color-mix(in srgb, var(--c-muted) 22%, var(--c-bg));
      --m-other-hover: color-mix(in srgb, var(--c-muted) 40%, var(--c-bg));
    }
  }
  .muni-map { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 300px); gap: 1.5rem; align-items: start; margin: 1.5rem 0 1rem; }
  .muni-map figure { margin: 0; }
  .map-main svg { display: block; width: 100%; height: auto; max-height: 82vh; }
  .map-side { position: sticky; top: 1rem; display: grid; gap: 1rem; }
  .map-inset { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: .6rem; }
  .map-inset svg { display: block; width: 100%; height: auto; }
  .map-inset figcaption { margin-top: .3rem; }
  path { stroke: var(--c-bg); stroke-width: .6px; vector-effect: non-scaling-stroke; stroke-linejoin: round; transition: fill .12s; }
  .map-inset path { stroke-width: 1px; }
  .m-followed { fill: var(--m-on); }
  .m-pending { fill: var(--m-pending); }
  .m-other { fill: var(--m-other); }
  a:hover path.m-followed, a:focus-visible path.m-followed, path.m-followed.hover { fill: var(--c-accent); }
  a:hover path.m-pending, a:focus-visible path.m-pending, path.m-pending.hover { fill: var(--m-pending-hover); }
  path.m-other.hover { fill: var(--m-other-hover); }
  svg a:focus-visible { outline: none; }
  svg a:focus-visible path { stroke: var(--c-text); stroke-width: 2px; }
  .lbl { font-size: 24px; font-weight: 650; text-anchor: middle; dominant-baseline: middle; pointer-events: none; paint-order: stroke; stroke-width: 5px; stroke-linejoin: round; }
  .lbl-followed { fill: var(--m-on-text); stroke: var(--m-on); }
  .lbl-pending { fill: var(--c-text); stroke: var(--m-pending); font-size: 18px; }
  .inset-frame { fill: none; stroke: var(--c-text); stroke-width: 1px; vector-effect: non-scaling-stroke; stroke-dasharray: 3 2; pointer-events: none; }
  .map-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .map-legend li { display: flex; align-items: center; gap: .5rem; }
  .swatch { width: 1.1rem; height: 1.1rem; border-radius: 4px; flex: none; border: 1px solid var(--c-border); }
  .swatch.m-followed { background: var(--m-on); }
  .swatch.m-pending { background: var(--m-pending); }
  .swatch.m-other { background: var(--m-other); }
  .map-label { margin: 0; padding: .6rem .8rem; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); display: grid; }
  .map-label[hidden] { display: none; }
  .map-source { margin-top: 1rem; }
  .muni-map.compact { grid-template-columns: 1fr; margin: 0; }
  .muni-map.compact .map-side { position: static; grid-template-columns: 1fr 1fr; align-items: start; }
  .muni-map.compact .map-label { grid-column: 1 / -1; }
  .muni-map.compact .map-main svg { max-height: 70vh; }
  @media (max-width: 760px) {
    .muni-map { grid-template-columns: 1fr; }
    .muni-map.compact .map-side { grid-template-columns: 1fr; }
    .map-side { position: static; }
    .map-main svg { max-height: none; }
    .map-label { display: none; }
  }
</style>
