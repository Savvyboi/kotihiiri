---
import { t } from '../i18n';
import type { VoteEvent, Choice } from '../lib/data';
import { groupColour } from '../lib/themes';
import VoteBar from './VoteBar.astro';
interface Props { vote: VoteEvent }
const { vote } = Astro.props;

// Per-group tallies and each group's majority choice among jaa/ei/tyhja.
const groups = new Map<string, Record<Choice, number>>();
for (const b of vote.ballots) {
  const g = b.group_text ?? '';
  const row = groups.get(g) ?? { jaa: 0, ei: 0, tyhja: 0, poissa: 0 };
  row[b.choice] += 1;
  groups.set(g, row);
}
const majority = new Map<string, Choice | undefined>();
for (const [g, c] of groups) {
  const ranked = (['jaa', 'ei', 'tyhja'] as Choice[]).sort((a, b) => c[b] - c[a]);
  majority.set(g, c[ranked[0]] > c[ranked[1]] ? ranked[0] : undefined);
}
const hasGroups = vote.ballots.some((b) => b.group_text);
const against = (b: VoteEvent['ballots'][number]) =>
  hasGroups && b.choice !== 'poissa' && majority.get(b.group_text ?? '') && b.choice !== majority.get(b.group_text ?? '');
const ballots = [...vote.ballots].sort((a, b) =>
  (a.group_text ?? '').localeCompare(b.group_text ?? '', 'fi') || a.person_ref.raw.localeCompare(b.person_ref.raw, 'fi'));
---
<section class="card vote">
  <h3>{t('vote.title', { n: vote.ordinal })}</h3>
  <div class="vote-labels">
    <div><b>{t('vote.jaaMeans')}:</b> {vote.jaa_label}</div>
    <div><b>{t('vote.eiMeans')}:</b> {vote.ei_label}</div>
  </div>
  <VoteBar counts={vote.counts} />
  {vote.result_text && <p style="margin-top:.6rem"><b>{t('vote.result')}:</b> {vote.result_text}</p>}
  {vote.needs_review && <p class="small muted">{t('vote.needsReview')}</p>}

  {hasGroups && (
    <details open>
      <summary>{t('vote.byGroup')}</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>{t('vote.group')}</th><th class="num">{t('vote.jaa')}</th><th class="num">{t('vote.ei')}</th><th class="num">{t('vote.tyhja')}</th><th class="num">{t('vote.poissa')}</th></tr></thead>
          <tbody>
            {[...groups.entries()].sort((a, b) => a[0].localeCompare(b[0], 'fi')).map(([g, c]) => (
              <tr><td><span class="dot" style={`background:${groupColour(g)}`} />{g}</td>
                <td class="num">{c.jaa}</td><td class="num">{c.ei}</td><td class="num">{c.tyhja}</td><td class="num">{c.poissa}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
  {ballots.length > 0 && (
    <details>
      <summary>{t('vote.members')} ({ballots.length})</summary>
      <div class="table-scroll">
        <table>
          <thead><tr><th>{t('vote.member')}</th>{hasGroups && <th>{t('vote.group')}</th>}<th>{t('vote.choice')}</th></tr></thead>
          <tbody>
            {ballots.map((b) => (
              <tr class:list={{ against: against(b) }}>
                <td>{b.person_ref.raw}{against(b) && <span class="visually-hidden"> ({t('vote.againstGroup')})</span>}</td>
                {hasGroups && <td>{b.group_text}</td>}
                <td><span class="dot" style={`background:var(--c-${b.choice})`} />{t(`vote.${b.choice}`)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</section>
