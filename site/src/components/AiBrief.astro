---
// An AI-written brief (PLAN.md §20), clearly labelled as such, with the model named and a pointer
// to the source text. Used on meeting pages (summary + highlights), item pages (brief) and votes
// (one line, `compact`). Labels go through <T> because item pages are translated client-side.
import { type Locale } from '../i18n';
import { modelName } from '../lib/briefs';
import T from './T.astro';
interface Props { text?: string; highlights?: string[]; model: string; lang?: string; locale: Locale; compact?: boolean }
const { text, highlights = [], model, lang = 'fi', locale, compact = false } = Astro.props;
---
{compact ? (
  <p class="ai-brief compact" data-pagefind-ignore>
    <span class="ai-tag" title={modelName(model)}><T k="brief.tag" locale={locale} /></span>
    <span lang={lang}>{text}</span>
  </p>
) : (
  <aside class="ai-brief" aria-labelledby="ai-brief-h">
    <p class="ai-head" id="ai-brief-h"><span class="ai-tag"><T k="brief.tag" locale={locale} /></span> <b><T k="brief.title" locale={locale} /></b></p>
    {text && <p class="ai-text" lang={lang}>{text}</p>}
    {highlights.length > 0 && <ul class="ai-points" lang={lang}>{highlights.map((h) => <li>{h}</li>)}</ul>}
    <p class="ai-note small muted"><T k="brief.disclaimer" vars={{ model: modelName(model) }} locale={locale} /></p>
  </aside>
)}
