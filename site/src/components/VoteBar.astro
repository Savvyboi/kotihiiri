---
import { t, type Locale } from '../i18n';
import type { Choice } from '../lib/data';
import T from './T.astro';
interface Props { counts: Record<Choice, number>; legend?: boolean; locale: Locale }
const { counts, legend = true, locale } = Astro.props;
const order: Choice[] = ['jaa', 'ei', 'tyhja', 'poissa'];
const total = order.reduce((n, c) => n + (counts[c] ?? 0), 0) || 1;
---
<div class="vote-bar" role="img" aria-label={t('vote.summary', counts, locale)}>
  {order.map((c) => counts[c] ? <span class={c} style={`width:${((counts[c] / total) * 100).toFixed(2)}%`} /> : null)}
</div>
{legend && (
  <ul class="vote-legend">
    {order.map((c) => <li><i style={`background:var(--c-${c})`} /><T k={`vote.${c}`} locale={locale} /> <b>{counts[c] ?? 0}</b></li>)}
  </ul>
)}
