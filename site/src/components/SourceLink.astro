---
import type { Locale } from '../i18n';
import T from './T.astro';
interface Props { href: string; system?: string; updated?: string; locale: Locale }
const { href, system, updated, locale } = Astro.props;
---
<p class="small muted">
  <a href={href} rel="external noopener"><T k="source.link" locale={locale} /></a>
  {system && <> · <T k="source.system" vars={{ system }} locale={locale} /></>}
  {updated && <> · {updated}</>}
</p>
