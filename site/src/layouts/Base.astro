---
import '@fontsource-variable/bitter';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import '../styles/themes.css';
import { t, localePath, assetPath, splitLocale, LOCALES, type Locale } from '../i18n';
import { cities, majorCities, cityName, IS_DEMO } from '../lib/data';
import Logo from '../components/Logo.astro';
import T from '../components/T.astro';
import SharedI18n from '../components/SharedI18n.astro';

interface Props {
  title?: string; description?: string; city?: string; locale: Locale;
  /** Built once at its Finnish path and translated client-side (item pages). */
  shared?: boolean;
  /** Path of this page's RSS feed, announced to feed readers. */
  feed?: string;
}
const { title, city, locale, shared = false, feed } = Astro.props;
const description = Astro.props.description ?? t('site.tagline', {}, locale);
const cityRec = city ? cities().find((c) => c.id === city) : undefined;
const fullTitle = title ? `${title} · ${t('site.name', {}, locale)}` : `${t('site.name', {}, locale)} · ${t('home.title', {}, locale)}`;
const { rest } = splitLocale(Astro.url.pathname);
const nav = [
  { href: '/kokoukset/', key: 'nav.meetings' },
  { href: '/aanestykset/', key: 'nav.votes' },
  { href: '/aiheet/', key: 'nav.topics' },
  { href: '/puolueet/', key: 'nav.parties' },
  { href: '/valtuutetut/', key: 'nav.councillors' },
  { href: '/aloitteet/', key: 'nav.initiatives' },
  { href: '/talous/', key: 'nav.budget' },
  { href: '/vertailu/', key: 'nav.compare' },
  { href: '/haku/', key: 'nav.search' },
  { href: '/data/', key: 'nav.data' },
  { href: '/tietoa/', key: 'nav.about' },
] as const;
const langHref = (l: Locale) => shared ? localePath(rest) + (l === 'fi' ? '' : `?lang=${l}`) : localePath(rest, l);
const site = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site).origin : '';
---
<!doctype html>
<html lang={locale} data-city={city}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg')} />
    {!shared && (LOCALES as Locale[]).map((l) => <link rel="alternate" hreflang={l} href={`${site}${localePath(rest, l)}`} />)}
    {feed && <link rel="alternate" type="application/rss+xml" title={fullTitle} href={assetPath(feed)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main"><T k="site.skip" locale={locale} /></a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localePath('/', locale)}>
          <Logo />{t('site.name', {}, locale)}{cityRec && <span class="city">/ {cityName(cityRec, locale)}</span>}
        </a>
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path class="bars" d="M2 4.5h16M2 10h16M2 15.5h16" /><path class="cross" d="M4 4l12 12M16 4 4 16" /></svg>
          <T k="nav.menu" locale={locale} />
        </button>
        <div class="site-menu" id="site-menu">
        <nav class="site-nav" aria-label={t('nav.main', {}, locale)} data-i18n-aria="nav.main">
          <ul>
            {nav.map((n) => (
              <li><a href={localePath(n.href, locale)} aria-current={rest === n.href ? 'page' : rest.startsWith(n.href) ? 'true' : undefined} aria-keyshortcuts={n.href === '/haku/' ? 'Control+K' : undefined} data-search-link={n.href === '/haku/' ? '' : undefined}><T k={n.key} locale={locale} /></a></li>
            ))}
          </ul>
        </nav>
        </div>
      </div>
      <div class="city-switch">
        <div class="wrap"><nav class="cities" aria-label={t('nav.cities', {}, locale)} data-i18n-aria="nav.cities"><ul>
          {majorCities().filter((c) => c.enabled).map((c) => (
            <li><a href={localePath(`/${c.id}/`, locale)} aria-current={c.id === city ? 'page' : undefined}>{cityName(c, locale)}</a></li>
          ))}
          <li><a href={localePath('/#kunnat', locale)} aria-current={cityRec && cityRec.rank > 6 ? 'page' : undefined}><T k="nav.allMunicipalities" locale={locale} /></a></li>
          <li><a href={localePath('/kartta/', locale)} aria-current={rest === '/kartta/' ? 'page' : undefined}><T k="nav.map" locale={locale} /></a></li>
        </ul></nav>
        <nav class="lang-switch" aria-label={t('nav.language', {}, locale)} data-i18n-aria="nav.language" data-lang-switch>
          <ul>
            {(LOCALES as Locale[]).map((l) => (
              <li><a href={langHref(l)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>{l.toUpperCase()}<span class="visually-hidden"> {t(`lang.${l}`, {}, l)}</span></a></li>
            ))}
          </ul>
        </nav>
        </div>
      </div>
    </header>
    {IS_DEMO && <div class="demo-banner" role="note"><div class="wrap"><T k="site.demo" locale={locale} /></div></div>}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span><T k="footer.licence" locale={locale} /></span>
        <span><T k="footer.noCookies" locale={locale} /> <a href={localePath('/tietoa/', locale)}><T k="nav.about" locale={locale} /></a></span>
      </div>
    </footer>
    {shared && <SharedI18n />}
    <script is:inline>
      // Compact menu: if the main menu wraps below the site name, fold them behind the
      // menu button (global.css, .compact). Measured again when the window changes size.
      (() => {
        const header = document.querySelector('.site-header');
        const btn = header.querySelector('[data-menu-toggle]');
        const brand = header.querySelector('.brand');
        const set = (open) => { header.classList.toggle('menu-open', open); btn.setAttribute('aria-expanded', String(open)); };
        const fit = () => {
          header.classList.remove('compact');
          const top = brand.getBoundingClientRect().top;
          const wraps = [...header.querySelectorAll('.site-nav li')].some((li) => li.getBoundingClientRect().top > top + 30);
          header.classList.toggle('compact', wraps);
          if (!wraps) set(false);
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.classList.contains('menu-open')) { set(false); btn.focus(); } });
        addEventListener('resize', fit);
        fit();
        document.fonts?.ready.then(fit);
      })();
      // Ctrl+K (⌘K on a Mac) opens search, as on the parliament and wellbeing-services sites.
      addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'k' || !(e.ctrlKey || e.metaKey) || e.altKey || e.shiftKey) return;
        const box = document.querySelector('.pagefind-ui__search-input');
        if (box) { e.preventDefault(); box.focus(); return; }
        const link = document.querySelector('[data-search-link]');
        if (link) { e.preventDefault(); location.href = link.href; }
      });
    </script>
  </body>
</html>
