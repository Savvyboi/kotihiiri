      "pykala": 6,
      "sections": [
        {
          "text": "Tarkastuslautakunta kuuli kokouksessaan 10.9.2025 vuoden 2025 arviointisuunnitelman mukaisesti\nVantaan elinikäisen oppimisen palvelualueen esittelyn. Aiheista on laadittu muistio, joka on jaettu\ntarkastuslautakunnalle kokouskutsun yhteydessä luottamushenkilöiden extranetissä.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Tarkastuslautakunta merkitsee muistiot tiedoksi.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Drilon Kllokoqi ilmoitti olevansa esteellinen asiassa ja poistui kokouksesta klo 19.32.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.",
          "type": "decision"
