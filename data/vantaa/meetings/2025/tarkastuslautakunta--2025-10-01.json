      "motions": [],
      "ordinal": 4,
      "preparers": [],
      "pykala": 4,
      "sections": [
        {
          "text": "SH/KB-H/KS\nTarkastuslautakunta on 13.8.2025 kokouksessaan hyväksynyt vuoden 2025 arviointisuunnitelmansa,\njohon sisältyy kaupungin rahoitus- ja sijoitustoiminnan sekä varallisuuden hoidon arviointi. Tavoitteena\non arvioida kaupungin rahoitus- ja sijoitustoimintaa sekä tutustua kaupungin rahoitusyksikön\ntoimintaan.\nAihetta tulee esittelemään rahoitusjohtaja Pirjo Van Nues.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään merkitä tiedoksi kuultu esittely.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.",
          "type": "decision"
        }
      ],
