          "url": "https://paatokset.vantaa.fi/ktwebscr/fileshow?doctype=3&docid=3143122&version=1"
        }
      ],
      "case_number": "VD/3594/00.03.00.00/2025",
      "content_sha256": "4f44859b6009769604f42eb4ceb63e88a1fcbc7a35aedba8458dadd2960a54bf",
      "disqualified": [],
      "id": "vantaa/tarkastuslautakunta/2025-05-20/4",
      "meeting_id": "vantaa/tarkastuslautakunta/2025-05-20",
      "motions": [],
      "ordinal": 4,
      "preparers": [],
      "pykala": 4,
      "sections": [
        {
          "text": "Kuntalain (410/2015) 121 §:n mukaan tarkastuslautakunnan tehtävänä on arvioida, ovatko valtuuston\nasettamat toiminnan ja talouden tavoitteet kunnassa ja kuntakonsernissa toteutuneet ja onko toiminta\njärjestetty tuloksellisella ja tarkoituksenmukaisella tavalla. Tehtäväänsä liittyen tarkastuslautakunnan\ntulee laatia arviointisuunnitelma.\nKaupunginreviisori on valmistellut luonnoksen tarkastuslautakunnan arviointisuunnitelmaksi\ntoimintavuodelle 1.6.2025–31.5.2026. Kesäkuussa 2025 tehtävänsä aloittavalla uudella\ntarkastuslautakunnalla on mahdollisuus muuttaa arviointisuunnitelmaa ja se on tarkoitus hyväksyä\ntarkastuslautakunnan kokouksessa 13.8.2025.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään hyväksyä alustava arviointisuunnitelma toimintavuodelle 1.6.2025–31.5.2026.\nPöytäkirja tarkastetaan ja hyväksytään tämän pykälän osalta heti kokouksessa.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Vuoden 2025 arviointisuunnitelmasta käytiin keskustelua. Lisäksi nousi esiin arviointiaiheita tuleville\nvaltuustokauden vuosille. Aiheet kootaan aloittavan tarkastuslautakunnan käyttöön ja suunnittelun\ntueksi.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.\nPöytäkirja tarkastettiin ja hyväksyttiin tämän pykälän osalta heti kokouksessa.",
          "type": "decision"
        }
      ],
