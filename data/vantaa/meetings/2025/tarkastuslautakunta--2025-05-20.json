    {
      "attachments": [],
      "case_number": "VD/3611/02.01.02.00/2025",
      "content_sha256": "d145ef0250c8893edc5bdf52dfb2f77edf917361b274f6b9dedbf3c1b9fd80fd",
      "disqualified": [],
      "id": "vantaa/tarkastuslautakunta/2025-05-20/5",
      "meeting_id": "vantaa/tarkastuslautakunta/2025-05-20",
      "motions": [],
      "ordinal": 5,
      "preparers": [],
      "pykala": 5,
      "sections": [
        {
          "text": "Taloussuunnittelu oli pyytänyt toimittamaan 15.5.2025 mennessä vuoden 2025 ensimmäisen\nosavuosikatsauksen ajalta 1.1.–30.4.2025.\nTalousarvion määrärahojen ja tuloarvioiden toteutumisarvioiden perusteena oli Vantaan\ntalousraportoinnin Power BI toteumatiedot ajalta 1.1.–30.4.2025 sekä toimialan tiedossa olleet\nloppuvuotta koskevat muutokset.\nVuoden 2025 käyttösuunnitelman määräraha on 682 300,94 euroa, josta 30.4.2025 mennessä oli\nkäytetty 153 094,56 euroa eli 22,4 prosenttia.\nOsavuosikatsaus 1/2025\nTalousarvion toteutuminen 2025\nToteumaprosentti tammi-huhtikuussa oli 22,4\nToiminnan kehittäminen ja keskeiset muutokset\nTarkastuslautakunta ja ulkoinen tarkastus on toiminut vahvistetun toimintasuunnitelman ja\narviointisuunnitelman mukaisesti. Tilintarkastus on toteutunut suunnitellusti. Toimintaa kehitetään\nresurssien puitteissa.\nKaupunginvaltuusto valitsi tammikuussa tarkastuslautakunnan valmistelun pohjalta vuosien 2025–2027\nhallinnon ja talouden tarkastajaksi tilintarkastusyhteisö KPMG Oy Ab:n. Sopimukseen sisältyvien\noptiokausien 2028–2029 sekä 2030 käyttämisestä päätetään erikseen.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään merkitä tiedoksi esittelyosan mukainen osavuosikatsaus 1/2025.\nPöytäkirja tarkastetaan ja hyväksytään tämän pykälän osalta heti kokouksessa.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.\nPöytäkirja tarkastettiin ja hyväksyttiin tämän pykälän osalta heti kokouksessa.",
          "type": "decision"
        }
      ],
