      "preparers": [],
      "pykala": 4,
      "sections": [
        {
          "text": "SH/KB-H/KS\nTarkastuslautakunta on 13.8.2025 kokouksessaan hyväksynyt vuoden 2025 arviointisuunnitelmansa,\njohon sisältyy henkilöstöjohtamisen ja henkilöstöpalvelujen palvelualueen arviointi. Tavoitteena on\narvioida kaupungin henkilöstöjohtamista sekä tutustua henkilöstöpalvelujen toimintaan. Aihetta tulee\nesittelemään henkilöstöjohtaja Tiina Harju-Kukkula.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään merkitä tiedoksi kuultu esittely.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.",
          "type": "decision"
        }
      ],
