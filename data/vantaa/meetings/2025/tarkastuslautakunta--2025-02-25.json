    {
      "attachments": [],
      "case_number": "VD/4382/00.03.00.00/2024",
      "content_sha256": "1aa0632e9ada217d868e18d7b5be92d4d8b98e92162573906fb01e20ece61836",
      "disqualified": [],
      "id": "vantaa/tarkastuslautakunta/2025-02-25/4",
      "meeting_id": "vantaa/tarkastuslautakunta/2025-02-25",
      "motions": [],
      "ordinal": 4,
      "preparers": [],
      "pykala": 4,
      "sections": [
        {
          "text": "SH/RP/KB-H/KS\nTarkastuslautakunta kuuli kokouksessaan 16.1.2025 vuoden 2024 arviointisuunnitelman mukaisesti\nhankintatoimen esittelyn. Tarkastuslautakunta kuuli kokouksessaan 12.2.2025 vuoden 2024\narviointisuunnitelman mukaisesti kotouttamisohjelman 2023–2026 esittelyn. Aiheista on laadittu\nmuistiot, jotka on jaettu tarkastuslautakunnalle kokouskutsun yhteydessä luottamushenkilöiden\nextranetissä.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Tarkastuslautakunta merkitsee muistiot tiedoksi.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.",
          "type": "decision"
        }
      ],
      "source_ids": {
        "docid": "3099119"
      },
      "source_url": "https://paatokset.vantaa.fi/ktwebscr/fileshow?doctype=3&docid=3099119",
      "statements": [],
