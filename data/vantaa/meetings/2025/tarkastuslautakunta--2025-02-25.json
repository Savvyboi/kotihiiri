    {
      "attachments": [],
      "case_number": "VD/4382/00.03.00.00/2024",
      "content_sha256": "bfb152e552ef232467dac59a21707ab1631b65fb03da566e489f04991ad7a2d9",
      "disqualified": [],
      "id": "vantaa/tarkastuslautakunta/2025-02-25/3",
      "meeting_id": "vantaa/tarkastuslautakunta/2025-02-25",
      "motions": [],
      "ordinal": 3,
      "preparers": [],
      "pykala": 3,
      "sections": [
        {
          "text": "Tarkastuslautakunta on 12.6.2024 kokouksessaan hyväksynyt vuoden 2024 arviointisuunnitelmansa,\njohon sisältyy Vantaan joukkoliikenteen ja Vantaan ratikan arviointi. Tavoitteena on saada kuva Vantaan\njoukkoliikenteen suunnittelusta, joukkoliikenteen toteutukseen vaikuttavista ajankohtaisista asioista ja\najankohtainen tieto Vantaan ratikkahankkeesta.\nAihetta tulevat esittelemään, suunnittelupäällikkö Markus Holm ja kadunsuunnittelupäällikkö Sauli\nHakkarainen ja Vantaan ratikan hankejohtaja Hannu Lehtikankare.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään merkitä tiedoksi kuultu esittely.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Siri Ahokas, Tarja Eklund ja Oskari Iivarinen ilmoittivat olevansa esteellisiä Vantaan ratikkaa koskevassa\nasiassa ja poistuivat kokouksesta asian käsittelyn ajaksi klo 17.05–18.03.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.",
          "type": "decision"
        }
      ],
      "source_ids": {
        "docid": "3099117"
