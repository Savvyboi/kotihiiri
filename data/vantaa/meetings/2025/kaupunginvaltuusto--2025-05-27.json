      "motions": [],
      "ordinal": 2,
      "preparers": [],
      "pykala": 2,
      "sections": [
        {
          "heading": "Esitys",
          "text": "Päätetään\na) valita kaksi pöytäkirjantarkastajaa toimittamaan pöytäkirjan tarkastus sähköisenä\nmaanantaina 2.6.2025 klo 16.00 ja\nb) pitää tarkastettu pöytäkirja yleisesti nähtävänä kaupungin internetsivuilla\n(www.vantaa.fi/paatoksenteko) keskiviikosta 4.6.2025 lähtien.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätettiin\na) valita Paula Lehmuskallio ja Pirkko Letto pöytäkirjantarkastajiksi toimittamaan pöytäkirjan\ntarkastus sähköisenä maanantaina 2.6.2025 klo 16.00 ja\nb) pitää tarkastettu pöytäkirja yleisesti nähtävänä kaupungin internetsivuilla\n(www.vantaa.fi/paatoksenteko) keskiviikosta 4.6.2025 lähtien.",
          "type": "decision"
        }
      ],
