      "motions": [],
      "ordinal": 3,
      "preparers": [],
      "sections": [
        {
          "text": "Tarkastuslautakunta on 10.6.2026 kokouksessaan hyväksynyt vuoden 2026 arviointisuunnitelmansa,\njohon sisältyy tutustumiskäynti Vantaan Energian jätevoimalaan. Tavoitteena on arvioida Vantaan kaupunginvaltuuston yhtiölle asettamien tavoitteiden toteutumista sekä tutustua Vantaan Energia Oy:n ja\nVantaa Energia-konsernin toimintaan.\nAihetta esittelee Vantaan Energia Oy:n toimitusjohtaja Jukka Toivonen.\nTarkastuslautakunta 26.11.2026\nKaupunginreviisorin esitys:\nPäätetään merkitä tiedoksi kuultu esittely.",
          "type": "background"
        }
      ],
      "source_ids": {
        "docid": "3487095"
      },
      "source_url": "https://paatokset.vantaa.fi/ktwebscr/fileshow?doctype=3&docid=3487095",
      "statements": [],
      "status": "active",
      "title": "Vantaan Energia Oy",
      "votes": []
    },
    {
