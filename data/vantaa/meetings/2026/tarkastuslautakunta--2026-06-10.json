      "preparers": [],
      "pykala": 4,
      "sections": [
        {
          "text": "Kaupunginreviisori esittelee luonnoksen tarkastuslautakunnan toimintasuunnitelmaksi toimintavuodelle\n1.6.2026–31.5.2027.\nEsittelyn jälkeen käydään keskustelua tarkastuslautakunnan työn kehittämisestä.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään hyväksyä toimintasuunnitelma toimintavuodelle 1.6.2026–31.5.2027 ja\nmerkitään tiedoksi käyty keskustelu tarkastuslautakunnan työn kehittämisestä.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.",
