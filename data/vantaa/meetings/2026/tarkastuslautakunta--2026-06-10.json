    {
      "attachments": [],
      "case_number": "VD/3743/02.01.02.00/2026",
      "content_sha256": "7fdec5d628f29f6c6808737fceb1ba971f6d7d3cf5b5c48798df9b78fbeb61c3",
      "disqualified": [],
      "id": "vantaa/tarkastuslautakunta/2026-06-10/7",
      "meeting_id": "vantaa/tarkastuslautakunta/2026-06-10",
      "motions": [],
      "ordinal": 7,
      "preparers": [],
      "pykala": 7,
      "sections": [
        {
          "text": "Taloussuunnittelu oli pyytänyt toimittamaan 11.5.2026 mennessä vuoden 2026 ensimmäisen osavuosikatsauksen ajalta 1.1.–30.4.2026.\nTalousarvion määrärahojen ja tuloarvioiden toteutumisarvioiden perusteena oli Vantaan talousraportoinnin Power BI toteumatiedot ajalta 1.1.–30.4.2026 sekä toimialan tiedossa olleet loppuvuotta koskevat muutokset.\nVuoden 2026 käyttösuunnitelman määräraha on 676 744, 84 euroa, josta 30.4.2026 mennessä oli käytetty 176 645, 41 euroa eli 26,1 prosenttia.\nOsavuosikatsaus 1/2026\nTalousarvion toteutuminen 2026\nToteumaprosentti tammi-huhtikuussa oli 26,1.\nToiminnan kehittäminen ja keskeiset muutokset\nTarkastuslautakunta ja ulkoinen tarkastus on toiminut vahvistetun toimintasuunnitelman ja arviointisuunnitelman mukaisesti. Tilintarkastus on toteutunut suunnitellusti. Toimintaa kehitetään resurssien\npuitteissa.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään merkitä tiedoksi esittelyosan mukainen osavuosikatsaus 1/2026.\nPöytäkirja tarkastetaan ja hyväksytään tämän pykälän osalta heti kokouksessa.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.\nPöytäkirja tarkastettiin ja hyväksyttiin tämän pykälän osalta heti kokouksessa.",
          "type": "decision"
        }
      ],
