    {
      "attachments": [],
      "case_number": "VD/7668/00.03.00.00/2025",
      "content_sha256": "34c2704df7ed90e5ba3017ec70dac5e346692dec17a41a2a28b6feebc959206f",
      "disqualified": [],
      "id": "vantaa/tarkastuslautakunta/2026-06-10/5",
      "meeting_id": "vantaa/tarkastuslautakunta/2026-06-10",
      "motions": [],
      "ordinal": 5,
      "preparers": [],
      "pykala": 5,
      "sections": [
        {
          "text": "Kuntalain (410/2015) 121 §:n mukaan tarkastuslautakunnan tehtävänä on arvioida, ovatko valtuuston\nasettamat toiminnan ja talouden tavoitteet kunnassa ja kuntakonsernissa toteutuneet ja onko toiminta\njärjestetty tuloksellisella ja tarkoituksenmukaisella tavalla. Tehtäväänsä liittyen tarkastuslautakunnan\ntulee laatia arviointisuunnitelma.\nKaupunginreviisori on valmistellut luonnoksen tarkastuslautakunnan arviointisuunnitelmaksi toimintavuodelle 1.6.2026–31.5.2027.",
          "type": "background"
        },
        {
          "heading": "Kaupunginreviisorin esitys",
          "text": "Päätetään hyväksyä alustava arviointisuunnitelma toimintavuodelle 1.6.2026–31.5.2027.\nPöytäkirja tarkastetaan ja hyväksytään tämän pykälän osalta heti kokouksessa.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Tarkastuslautakunta kävi keskustelua arviointisuunnitelmasta. Keskustelun kuluessa esitettiin arviointiaiheisiin liittyviä tarkennuksia ja lisäyksiä, jotka päivitettiin suunnitelmaan ja huomioidaan arviointeja valmisteltaessa.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Hyväksyttiin esitys.\nPöytäkirja tarkastettiin ja hyväksyttiin tämän pykälän osalta heti kokouksessa.",
          "type": "decision"
        }
      ],
