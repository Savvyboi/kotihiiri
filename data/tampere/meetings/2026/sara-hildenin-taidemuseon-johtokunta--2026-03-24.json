      "presenter": "Hjorth-Röntynen Anna, Museonjohtaja",
      "pykala": 21,
      "sections": [
        {
          "heading": "Perustelut",
          "text": "Museonjohtaja esittelee museon ajankohtaisia asioita.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Merkitään tiedoksi.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätösehdotus hyväksyttiin.\n\nVahvistettiin syksyn 2026 Martha Diamondin näyttelyn aikatauluksi 19.9.2026-17.1.2027.\n\nVahvistettiin vuoden 2027 näyttelyiden alustava aikataulu seuraavasti:\n\n1. 13.2.-30.5.2027\n\n2. 19.6.-26.9.2027\n\n3. 23.10.2027-30.1.2028\n\nKeskusteltiin kehysvalmistelusta ja investoinneista 2027.",
          "type": "decision"
        }
      ],
