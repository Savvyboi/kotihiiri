        {
          "heading": "Perustelut",
          "text": "Johtokunnan pöytäkirjan allekirjoittavat pöytäkirjanpitäjä (esittelijä), johtokunnan puheenjohtaja sekä kaksi pöytäkirjantarkastajiksi valittua johtokunnan jäsentä. Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 15.1.2026.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Valitaan kaksi pöytäkirjantarkastajaa.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Pöytäkirjantarkastajiksi valittiin Ilkka Jokinen ja Pia Nordström.",
          "type": "decision"
        }
      ],
