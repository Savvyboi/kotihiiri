      "presenter": "Nikander Heli, Kaupunginreviisori",
      "pykala": 17,
      "sections": [
        {
          "heading": "Perustelut",
          "text": "Kokoukseen on mahdollista osallistua joko kokouspaikassa tai sähköisesti. Sähköisestä kokouksesta säädetään kuntalain 99 §:ssä ja määrätään kaupungin hallintosäännön 116 §:ssä. Sähköisen kokouksen toteuttamiseen käytetään Selma-päätöksentekojärjestelmää ja Teams-sovellusta.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Todetaan kokouksen laillisuus ja päätösvaltaisuus.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätösehdotus hyväksyttiin.",
          "type": "decision"
        }
      ],
      "source_ids": {
