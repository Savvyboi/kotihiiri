        {
          "heading": "Perustelut",
          "text": "Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 19.2.2026.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Pöytäkirjantarkastajiksi valitaan Johannes Liuska ja Aarne Raevaara (varalle Mahmoud Machaal ja Aila Dündar-Järvinen).",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Pöytäkirjan tarkastajiksi valittiin Marjo Roivas ja Aarne Raevaara (varalle Mahmoud Machaal ja Aila Dündar-Järvinen).",
          "type": "decision"
        }
      ],
