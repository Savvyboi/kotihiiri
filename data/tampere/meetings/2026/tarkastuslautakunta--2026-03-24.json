      "sections": [
        {
          "heading": "Perustelut",
          "text": "Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 26.3.2026.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Pöytäkirjantarkastajiksi valitaan Sari Hänninen ja Saila Joutsio (varalle Sauli-Matti Kirveskari ja Markku Lahtinen).",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Pöytäkirjan tarkastajiksi valittiin Sari Hänninen ja Saila Joutsio (varalle Sauli-Matti Kirveskari).",
          "type": "decision"
        }
      ],
