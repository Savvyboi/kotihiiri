        {
          "heading": "Perustelut",
          "text": "Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 12.11.2026.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Pöytäkirjantarkastajiksi valitaan Saila Joutsio ja Sauli-Matti Kirveskari (varalle Markku Lahtinen ja Johannes Liuska).",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Pöytäkirjantarkastajiksi valittiin Sauli-Matti Kirveskari ja Johannes Liuska (varalle Markku Lahtinen).",
          "type": "decision"
        }
