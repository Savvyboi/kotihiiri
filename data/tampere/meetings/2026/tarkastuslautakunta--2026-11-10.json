    {
      "attachments": [],
      "case_number": "TRE:5655/00.00.03/2026",
      "content_sha256": "d8923c49f5a291be6652efc53b7a1082195499c1409ba91f36a39e338f4a2428",
      "disqualified": [],
      "id": "tampere/tarkastuslautakunta/2026-11-10/6",
      "meeting_id": "tampere/tarkastuslautakunta/2026-11-10",
      "motions": [],
      "ordinal": 6,
      "preparers": [],
      "presenter": "Nikander Heli, Kaupunginreviisori",
      "pykala": 105,
      "sections": [
        {
          "heading": "Perustelut",
          "text": "Hallintosäännön 117 §:n mukaan toimielin päättää kokoustensa ajan ja paikan. Kokous pidetään myös, milloin puheenjohtaja katsoo kokouksen tarpeelliseksi tai enemmistö toimielimen jäsenistä tekee puheenjohtajalle esityksen kokouksen pitämisestä ilmoittamansa asian käsittelyä varten. Tällöin puheenjohtaja määrää kokousajan. Puheenjohtaja voi perustellusta syystä peruuttaa kokouksen.\n\nTarkastuslautakunnan pääsääntöinen kokousaika on tiistaisin klo 14. Kokoukset ovat pääsääntöisesti hybridikokouksia.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Tarkastuslautakunnan kevään 2027 kokouspäiviksi päätetään seuraavat päivät:\n\ntiistai 2.2.\n\ntiistai 16.2.\n\ntiistai 9.3.\n\ntiistai 23.3.\n\ntiistai 13.4.\n\ntiistai 20.4.\n\ntiistai 4.5. klo 9\n\ntiistai 18.5.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Muutettu päätösehdotus hyväksyttiin.",
          "type": "decision"
        },
        {
          "heading": "Kokouskäsittely",
          "text": "Asian esittelijä kaupunginreviisori Heli Nikander muutti päätösehdotustaan siten, että kokouspäivistä poistettiin 18.5.2027 ja kokouspäiväksi lisättiin 1.6.2027.\n\nPuheenjohtaja totesi näin muutetun päätösehdotuksen olevan asian käsittelyn pohjana.",
          "type": "deliberation"
        }
      ],
