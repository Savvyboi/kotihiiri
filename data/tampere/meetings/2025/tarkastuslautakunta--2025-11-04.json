      "sections": [
        {
          "heading": "Perustelut",
          "text": "Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 6.11.2025.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Pöytäkirjantarkastajiksi valitaan Eevastiina Väisänen ja Mahmoud Machaal (varalle Aila Dündar-Järvinen ja Sari Hänninen).",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Pöytäkirjantarkastajiksi valittiin Eevastiina Väisänen ja Mahmoud Machaal (varalle Sari Hänninen).",
