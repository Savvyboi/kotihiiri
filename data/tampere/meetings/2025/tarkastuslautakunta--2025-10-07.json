    {
      "attachments": [],
      "case_number": "TRE:5138/00.00.03/2025",
      "content_sha256": "ebd2770a4318e2c3ba03782bb0a906d92b3631c035a0e27ad9723a20d0508eb4",
      "disqualified": [],
      "id": "tampere/tarkastuslautakunta/2025-10-07/7",
