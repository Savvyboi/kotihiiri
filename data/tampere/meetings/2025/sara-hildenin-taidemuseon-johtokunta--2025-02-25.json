      "sections": [
        {
          "heading": "Perustelut",
          "text": "Museonjohtaja esittelee Sara Hildénin taidemuseorakennuksen tämänhetkisen tilanteen.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Merkitään selvitys tiedoksi.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätösehdotus hyväksyttiin.",
          "type": "decision"
        },
        {
          "heading": "Kokouskäsittely",
          "text": "Museonjohtaja esitteli museorakennusta koskevat korjaussuunnitelmat vuodelle 2025. Korjaussuunnitelman aikataulusta saadaan varmistus Tilapalveluilta 3.3.2025. Korjaustoimenpiteet ajoittuvat syyskaudelle 2025, alustavasti syyskuusta marraskuuhun. Tästä johtuen sara Hildénin taidemuseolla tulee olemaan tauko näyttelytoiminnassa syyskuusta joulukuuhun 2025.",
          "type": "deliberation"
        }
      ],
