      "case_number": "TRE:1447/02.02.01/2024",
      "content_sha256": "ea161c6d911b73d8add441ed86dc84f6b7ccaba73606217644b1ed0bc00e9d71",
      "disqualified": [],
      "id": "tampere/sara-hildenin-taidemuseon-johtokunta/2025-02-25/6",
      "meeting_id": "tampere/sara-hildenin-taidemuseon-johtokunta/2025-02-25",
      "motions": [],
      "ordinal": 6,
      "preparers": [
        "Hjorth-Röntynen Anna"
      ],
      "presenter": "Hjorth-Röntynen Anna, Museonjohtaja",
      "pykala": 6,
      "sections": [
        {
          "heading": "Perustelut",
          "text": "Sara Hildénin taidemuseon tulos jäi huomattavasti negatiiviseksi tilikaudella 2024. Toimintakate oli 0,236 milj. euroa negatiivinen vuosisuunnitelmaan verrattuna. Menot ylittyivät 0,580 milj. euroa ja tulot ylittyivät 0,345 milj. euroa. Menojen ylitys tapahtui kaikissa tiliryhmissä. Henkilöstömenojen kasvu johtui tuetun työllistämisen muuttuneista käytännöistä, sijaisuuksien määrällisestä kasvusta sekä tarpeen kasvusta. Vuokramenojen ylitys aiheutui näyttelyiden toteutukseen liittyvien koneiden vuokrista. Tulojen kasvu perustui hyvään kävijämäärään, Asiakkaita oli kaikkiaan 72875 ja avoinnaolopäiviä 246.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Hyväksytään tilinpäätöksen muotoon laadittu talousarvion seurantaraportti 1-12 2024.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätösehdotus hyväksyttiin.\n\nJäsen Sirkesalo poistui kokouksesta ennen tämän pykälän käsittelyä.",
          "type": "decision"
        },
        {
          "heading": "Kokouskäsittely",
          "text": "Esittelylistan käsittelyjärjestystä muutettiin ensimmäisessä pykälässä puheenjohtajan ehdotuksesta.\n\nTämä pykälä käsiteltiin viimeisenä pykälänä kokouksessa..",
          "type": "deliberation"
        }
      ],
