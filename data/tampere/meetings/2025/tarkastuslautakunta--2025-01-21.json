      "disqualified": [],
      "id": "tampere/tarkastuslautakunta/2025-01-21/5",
      "meeting_id": "tampere/tarkastuslautakunta/2025-01-21",
      "motions": [],
      "ordinal": 5,
      "preparers": [],
      "presenter": "Nikander Heli, Kaupunginreviisori",
      "pykala": 5,
      "sections": [
        {
          "heading": "Perustelut",
          "text": "Tilintarkastuksen hankintasopimuksessa on sovittu sopimuksen ulkopuolisista toimeksiannoista seuraavasti:\n\n5. Palvelun laadun valvonta ja tarkastusoikeus\n\nPalveluntuottajan tulee ilmoittaa etukäteen kirjallisesti tarkastuslautakunnalle palveluntuottajan tilaajalle tekemistä mahdollisista tämän sopimuksen ulkopuolisista muista toimeksiannoista.\n\nTilintarkastaja ilmoittaa tilintarkastussopimuksen mukaisesti, että BDO Oy on valittu tilintarkastussopimuksen ulkopuoliseen toimeksiantoon. Toimeksianto koskee tilintarkastajan näkemyksen antamista henkilökuntapysäköinnin omavastuuosuuden veron perusteesta (Frenckellin pysäköintihalli). Talousjohtaja Mikko Koskela on allekirjoittanut toimeksiantoa koskevan kaupungin ja BDO Oy:n välisen sopimuksen.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Merkitään tiedoksi tilintarkastajan ilmoitus tilintarkastussopimuksen ulkopuolisesta toimeksiannosta.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätösehdotus hyväksyttiin.",
          "type": "decision"
        },
        {
          "heading": "Kokouskäsittely",
          "text": "Asian esittelijä, kaupunginreviisori Heli Nikander tarkensi asian perusteluita seuraavasti:\n\n”Tilintarkastaja ilmoittaa riippumattomuutensa ALV työn osalta yhtiönä ja henkilönä. Tilintarkastajan ilmoituksen mukaan tilintarkastuksen riippumattomuus ei vaarannu\".",
          "type": "deliberation"
        }
      ],
