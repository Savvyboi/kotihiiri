        {
          "heading": "Perustelut",
          "text": "Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 14.8.2025.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Pöytäkirjantarkastajiksi valitaan Mahmoud Machaal ja Saila Joutsio (varalle Sauli-Matti Kirveskari ja Markku Lahtinen).",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Päätösehdotus hyväksyttiin.",
          "type": "decision"
        }
      ],
