        {
          "heading": "Perustelut",
          "text": "Johtokunnan pöytäkirjan allekirjoittavat pöytäkirjanpitäjä (esittelijä),​ johtokunnan puheenjohtaja sekä kaksi pöytäkirjantarkastajiksi valittua johtokunnan jäsentä. Pöytäkirja on tarkastettavana ja sähköisesti allekirjoitettavana viimeistään torstaina 18.12.2025.",
          "type": "background"
        },
        {
          "heading": "Päätösehdotus oli",
          "text": "Valitaan kaksi pöytäkirjantarkastajaa.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Pöytäkirjantarkastajiksi valittiin Anna Danska ja Jaakko Vuorio.",
          "type": "decision"
        }
