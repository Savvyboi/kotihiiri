      "pykala": 57,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa Helge Vuoti esitteli aihetta ja vastasi yhdessä kaupunkiympäristön toimialajohtajan Olli Isotalon kanssa tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Ulkoisen tarkastuksen yksikkö on toteuttanut tilintarkastusyhteisö BDO Oy:n avustamana keväällä 2026 kaupunginjohtajan toimeksiannosta erityistarkastuksen Rakennusvalvonnan toiminnasta. JHT, HT, CIA, CCSA, CISA, CFE Helge Vuoti ja Aku Vaselius BDO Audiator Oy:stä esittelevät kokouksessa tarkastuksen tuloksia. Kokoukseen on kutsuttu myös kaupunkiympäristön toimialajohtaja Olli Isotalo.",
          "type": "background"
        }
      ],
