      "pykala": 58,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta keskustelee valmistelun pohjalta seuraavan kokouksen aiheista.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan 10.6.2026 kokouksen aiheina ovat arviointisuunnitelman päivitys ja vuoden 2026 arviointiohjelma, syksyn 2026 ja kevään 2027 kokousajat, tarkastuslautakunnan ja tilintarkastuksen ensimmäinen osavuosikatsaus, tilintarkastuksen kilpailutus, vuoden 2025 arviointikertomuksen valtuustokäsittelyn palautekeskustelu ja tarkastuslautakunnan itsearviointi- ja palautekyselyn tulosten käsittely.",
          "type": "background"
        }
      ],
