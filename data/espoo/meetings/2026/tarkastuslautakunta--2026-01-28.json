        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa tietohallintojohtaja Maarit Waskilampi-Kuikka, tietohallintopäälliköt Juha Valtaharju ja Saku Jokinen, tietosuojavastaava Helena Niemi, tietoturvapäällikkö Harri Säkkinen sekä turvallisuusjohtaja Petri Häkkinen esittelivät aihetta ja vastasivat tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2025 arviointiohjelman mukaisesti tarkastuslautakunta kuulee esittelyn ajankohtaisista ICT-aiheista. Kokouksessa aihetta esittelevät tietohallintojohtaja Maarit Waskilampi-Kuikka, tietohallintopäälliköt Juha Valtaharju ja Saku Jokinen, tietosuojavastaava Helena Niemi, tietoturvapäällikkö Harri Säkkinen ja turvallisuusjohtaja Petri Häkkinen.",
          "type": "background"
        }
      ],
