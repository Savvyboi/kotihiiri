      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta antaa valtuustolle lausunnon vuoden 2026 talousarvion toisesta osavuosikatsauksesta ja esittää, että valtuusto merkitsee tarkastuslautakunnan lausunnon tiedoksi.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunta antaa valtuustolle lausunnon vuoden 2026 talousarvion toisesta osavuosikatsauksesta. Tarkastuslautakunnan tavoitteena on tuoda lausunnossaan julki keskeisiä toiminnallisia ja taloudellisia tekijöitä sekä arvioida tulostavoitteiden toteutumista ja seurantaa. Lausunto toimitetaan tarkastuslautakunnan kokouksen päätyttyä valtuuston 21.9.2026 kokouksen esityslistalle.",
          "type": "background"
        }
      ],
