      "pykala": 35,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi luonnoksesta käydyn keskustelun ja jatkaa käsittelyä kokouksessaan 15.4.2026.",
          "type": "proposal"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunta käsittelee arviointikertomuksen ensimmäistä luonnosta ja antaa jatkovalmisteluohjeita ulkoisen tarkastuksen yksikölle.\n\nTarkastuslautakunnan vuoden 2025 arviointikertomuksen ensimmäinen luonnos käsitellään 25.3.2026 ja toinen luonnos 15.4.2026. Arviointikertomuksen kolmas käsittely ja hyväksyminen ovat arviointiohjelman mukaan tarkastuslautakunnan kokouksessa 29.4.2026.",
          "type": "background"
        }
      ],
