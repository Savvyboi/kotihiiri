      "pykala": 34,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen ja jatkaa aiheen käsittelyä arviointikertomuksen valmistelun yhteydessä.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa henkilöstöjohtaja Jutta Takala esitteli vuoden 2025 henkilöstötunnusluvut ja vastasi tarkastuslautakunnan jäsenten esittämiin kysymyksiin. Pääluottamusedustajat Laura Raittola ja Elina Nyman kommentoivat aihetta ja esittelivät pääluottamusedustajien toimintaa sekä vastasivat tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2025 arviointiohjelman mukaisesti kokouksen aiheena on kaupungin henkilöstötunnusluvut. Kokoukseen on kutsuttu henkilöstöjohtaja Jutta Takala. Lisäksi pääluottamusedustajista kokoukseen osallistuvat Laura Raittola ja Elina Nyman, jotka esittelevät pääluottamusedustajien toimintaa.",
          "type": "background"
        }
      ],
