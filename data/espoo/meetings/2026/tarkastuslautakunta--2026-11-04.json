      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen ja jatkaa aiheen käsittelyä arviointikertomuksen valmisteluvaiheessa.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa yhteysjohtaja Niko Ferm ja tutkimusjohtaja Minna Joensuu sekä perusopetuksen johtaja Juha Nurmi esittelivät aihetta ja vastasivat tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2026 arviointiohjelman mukaisesti kokouksen aiheena on kaupungin tavoitteet, mittarit ja käytössä oleva tietopohja segregaation ehkäisyssä. Kokouksessa aihetta esittelevät yhteysjohtaja Niko Ferm ja tutkimusjohtaja Minna Joensuu sekä kasvun ja oppimisen toimialalta perusopetuksen johtaja Juha Nurmi.",
          "type": "background"
        }
      ],
