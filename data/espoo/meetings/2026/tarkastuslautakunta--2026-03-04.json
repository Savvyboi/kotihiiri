      "preparers": [
        "Jalli Aino"
      ],
      "presenter": "Kaupunginreviisori Ala-Aho Virpi",
      "pykala": 25,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa Espoon kaupungilta asiaa esittelivät ja esitettyihin kysymyksiin vastasivat kasvun ja oppimisen toimialalta opetuksen tuen päällikkö Miia Loisa-Turunen, varhaiskasvatuksen kehittämispäällikkö Marianne Jyväsjärvi, opetuspäällikkö Outi Saloranta-Eriksson, aluepäällikkö Kari Kotiniemi, erityisasiantuntija Veera Kambouris sekä elinvoiman tulosalueelta työllisyysjohtaja Hilla-Maaria Suomi, palvelualuepäällikkö Henna Kaukonen-Nyholm ja palvelupäällikkö Satu Venhola.\n\nLänsi-Uudenmaan hyvinvointialueelta asiaa esittelemässä ja kysymyksiin vastaamassa olivat palvelulinjajohtaja Kati Villgren, palveluyksikköpäällikkö Kirsi Aro, palvelulinjajohtaja Tapio Nieminen sekä palveluyksikköpäällikkö Eveliina Cammarano.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunta päätti 3.12.2025 § 84 yhteiskokouksen pitämisestä Länsi-Uudenmaan hyvinvointialueen tarkastuslautakunnan kanssa 4.3.2026. Kokouksen aiheena on Espoon vuoden 2025 talousarvion tulostavoitteen pohjalta Espoon kaupungin ja Länsi-Uudenmaan hyvinvointialueen rajapintojen ja palveluketjujen toimivuus. Kokoukseen on kutsuttu Espoon kaupungin ja Länsi-Uudenmaan hyvinvointialueen asiantuntijoita.",
          "type": "background"
        }
      ],
