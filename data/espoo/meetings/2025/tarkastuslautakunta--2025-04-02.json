      "presenter": "Kaupunginreviisori Ala-Aho Virpi",
      "pykala": 25,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadut selvitykset ja jatkaa aiheiden käsittelyä arviointikertomuksen valmistelun yhteydessä.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa rahoitusjohtaja Ari Konttas esitteli aiheita ja vastasi tarkastuslautakunnan jäsenten esittämiin kysymyksiin.\n\nAsian käsittely keskeytettiin klo 17.40 ja siirryttiin käsittelemään esityslistan seuraavaa kohtaa. Asia käsiteltiin loppuun §:ssä 26 kuullun esittelyn jälkeen.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan arviointiohjelman mukaisesti kokouksen aiheina ovat kaupungin tilinpäätös ja konsernitilinpäätös vuodelta 2024 sekä konsernin investoinnit ja Taloudellisesti kestävä Espoo -tuottavuusohjelman toteutuminen. Aiheita kokouksessa esittelee rahoitusjohtaja Ari Konttas.",
          "type": "background"
        }
      ],
      "source_ids": {
        "item_id": "20251414-3",
        "pdf": "https://espoo.oncloudos.com/kokous/20251414-3.PDF"
      },
