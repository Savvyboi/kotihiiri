        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi kokouksessa käydyn keskustelun.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa kaupunginhallituksen puheenjohtaja Mervi Katainen ja hallituksen 1. varapuheenjohtaja Henna Partanen esittelivät Espoon ajankohtaisia asioita ja vastasivat tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2024 arviointiohjelman mukaisesti Espoon keskeisistä haasteista ja muista ajankohtaisista asioista kokoukseen on kutsuttu keskustelemaan kaupunginhallituksen puheenjohtaja Mervi Katainen, 1. varapuheenjohtaja Henna Partanen ja 2. varapuheenjohtaja Maria Guzenina.",
          "type": "background"
        }
