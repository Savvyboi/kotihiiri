      "motions": [],
      "ordinal": 5,
      "preparers": [
        "Lepistö Jussi"
      ],
      "presenter": "Kaupunginreviisori Ala-Aho Virpi",
      "pykala": 75,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen ja jatkaa aiheen käsittelyä arviointikertomuksen valmisteluvaiheessa.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kokouksessa toimitusjohtaja Tommi Fred esitteli aihetta ja vastasi tarkastuslautakunnan jäsenten esittämiin kysymyksiin. Konserni- ja tilajaoston puheenjohtaja Henna Partanen sekä kaupunkiympäristön toimialajohtaja Olli Isotalo pitivät kokouksessa kommenttipuheenvuoron.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2025 arviointiohjelman mukaisesti kokouksen aiheena on Helsingin seudun ympäristöpalvelut -kuntayhtymä. Kokouksessa aihetta esittelee toimitusjohtaja Tommi Fred. Kokoukseen on kutsuttu myös kaupunkiympäristön toimialajohtaja Olli Isotalo, konserniohjauksen kehittämisjohtaja Maria Jyrkkä sekä konserni- ja tilajaoston puheenjohtaja Henna Partanen, joille on varattu mahdollisuudet kommenttipuheenvuoroon.",
          "type": "background"
        }
      ],
      "source_ids": {
        "item_id": "20251543-5",
        "pdf": "https://espoo.oncloudos.com/kokous/20251543-5.PDF"
      },
