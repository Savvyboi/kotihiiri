      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Tämä pykälä käsiteltiin kokouksessa § 75 jälkeen.\n\nKokouksessa kaupunkiympäristön toimialajohtaja Olli Isotalo esitteli aihetta ja vastasi tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2025 arviointiohjelman mukaisesti tarkastuslautakunta kuulee esittelyn Espoon maankäytön ja asumisen periaatteista sekä Helsingin kaupunkiseudun maankäytön, asumisen ja liikenteen (MAL) sopimuksesta. Kokouksessa aihetta esittelee kaupunkiympäristön toimialajohtaja Olli Isotalo.",
          "type": "background"
        }
      ],
