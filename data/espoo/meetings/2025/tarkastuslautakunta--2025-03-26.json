      "ordinal": 4,
      "preparers": [
        "Jalonen Pyry"
      ],
      "presenter": "Kaupunginreviisori Ala-Aho Virpi",
      "pykala": 19,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi kokouksessa kuullut selvitykset.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Valli teki seuraavan kannatetun lisäysehdotuksen:\n\nTarkastuslautakunta edellyttää tarkastuksen kohteelta tarkastushavaintojen tarkempaa läpikäymistä.\n\nPuheenjohtaja tiedusteli, voidaanko lisäysehdotus hyväksyä. Koska ehdotusta ei vastustettu, puheenjohtaja totesi sen tulleen yksimielisesti hyväksytyksi.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti ja edellyttää tarkastuksen kohteelta tarkastushavaintojen tarkempaa läpikäymistä.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Kokouksessa esitellään ulkoisen tarkastuksen yksikön oman työohjelman mukaisia tarkastuksia (Salassa pidettävä, JulkL 24.1 § 15 k.).",
          "type": "background"
        }
      ],
      "source_ids": {
