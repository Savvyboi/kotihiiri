      ],
      "presenter": "Kaupunginreviisori Ala-Aho Virpi",
      "pykala": 20,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi saadun selvityksen.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Esittelijä muutti päätösehdotuksensa muotoon:\n\nTarkastuslautakunta merkitsee tiedoksi saadun selvityksen ja ottaa johtopäätökset huomioon arviointikertomusvalmistelussa.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän muutetun päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Pääkaupunkiseudun tarkastuslautakuntien vuoden 2024 yhteisarvioinnin aiheena on sään ääri-ilmiöihin sopeutuminen ja varautuminen pääkaupunkiseudulla.\n\nVuoden 2024 yhteisarvioinnin koordinointivastuu oli Espoon kaupungilla. Espoon edustajina työryhmässä olivat kaupunkitarkastajat Aino Jalli ja Jussi Lepistö.",
          "type": "background"
        }
      ],
      "source_ids": {
        "item_id": "20251409-5",
        "pdf": "https://espoo.oncloudos.com/kokous/20251409-5.PDF"
      },
      "source_url": "https://espoo.oncloudos.com/cgi/DREQUEST.PHP?page=meetingitem&id=20251409-5",
      "statements": [],
      "status": "active",
      "title": "Pääkaupunkiseudun tarkastuslautakuntien vuoden 2024 yhteisarviointi: Sään ääri-ilmiöihin sopeutuminen ja varautuminen pääkaupunkiseudulla",
      "votes": []
    },
    {
      "attachments": [],
      "case_number": "611/00.03.00/2025",
      "content_sha256": "4c3262091fcb0769b58be546e7fddaf9c5375773e335aeb9124f4b11f1cb4a8b",
      "disqualified": [],
      "id": "espoo/tarkastuslautakunta/2025-03-26/6",
      "meeting_id": "espoo/tarkastuslautakunta/2025-03-26",
      "motions": [],
      "ordinal": 6,
      "preparers": [
        "Ala-Aho Virpi",
        "Väyrynen Heidi Jalonen Pyry Lepistö Jussi Jalli Aino"
      ],
      "presenter": "Kaupunginreviisori Ala-Aho Virpi",
      "pykala": 21,
      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta keskustelee arviointikertomukseen otettavista aiheista ja antaa valmisteluohjeita ulkoisen tarkastuksen yksikölle.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Puheenjohtajan ehdotuksesta arviointikertomuksen luonnos käsiteltiin kokouksessa luvuittain. Keskustelussa esiin nousseet ja kannatetut muutosehdotukset kirjattiin suoraan luonnokseen valmistelua ja seuraavaa käsittelyä varten.\n\nRavald ilmoitti olevansa esteellinen ja oli poistuneena klo 19.09–19.20 ja klo 20.12–20.13 käsiteltäessä koulutuskuntayhtymä Omniaa. Ravald toimii koulutuskuntayhtymä Omnian hallituksen varajäsenenä.\n\nViljakainen ilmoitti olevansa esteellinen ja oli poistuneena klo 19.09–19.11 käsiteltäessä Espoon teatterin tulostavoitteiden toteutumista. Viljakainen toimii Espoon teatterin hallituksen puheenjohtajana. Puheenjohtajan poissa ollessa kokouksen puheenjohtajana toimi varapuheenjohtaja Keisteri-Sipilä.\n\nTolonen ja Kanerva ilmoittivat olevansa esteellisiä ja olivat poistuneena klo 19.24–19.32 käsiteltäessä poikkihallinnollisia kehitysohjelmia. Tolonen on toiminut valtuustokaudella Elinvoimainen Espoo -kehitysohjelman ohjausryhmän jäsenenä. Kanerva on toiminut valtuustokaudella Hyvinvoiva Espoo -kehitysohjelman ohjausryhmän jäsenenä.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2024 arviointikertomuksen ensimmäinen luonnos käsitellään 26.03.2025 ja toinen luonnos 15.04.2025. Arviointikertomuksen kolmas käsittely ja hyväksyminen ovat arviointiohjelman mukaan tarkastuslautakunnan kokouksessa 29.04.2025.",
          "type": "background"
        }
      ],
