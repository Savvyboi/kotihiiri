      "sections": [
        {
          "heading": "Päätösehdotus",
          "text": "Tarkastuslautakunta merkitsee tiedoksi kokouksessa käydyn keskustelun.",
          "type": "proposal"
        },
        {
          "heading": "Käsittely",
          "text": "Kaupunginjohtaja Kai Mykkänen esitteli kokouksessa Espoon ajankohtaisia asioita ja vastasi tarkastuslautakunnan jäsenten esittämiin kysymyksiin.",
          "type": "deliberation"
        },
        {
          "heading": "Päätös",
          "text": "Tarkastuslautakunta hyväksyi esittelijän päätösehdotuksen yksimielisesti.",
          "type": "decision"
        },
        {
          "heading": "Selostus",
          "text": "Tarkastuslautakunnan vuoden 2024 arviointiohjelman mukaisesti Espoon keskeisistä haasteista ja muista ajankohtaisista asioista kokoukseen on kutsuttu keskustelemaan kaupunginjohtaja Kai Mykkänen.",
          "type": "background"
        }
      ],
