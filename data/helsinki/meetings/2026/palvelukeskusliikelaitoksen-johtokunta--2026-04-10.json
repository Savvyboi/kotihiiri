      "statements": [],
      "status": "active",
      "title": "Kokouksen laillisuuden ja päätösvaltaisuuden toteaminen sekä pöytäkirjan tarkastajien valinta",
      "votes": []
    },
    {
      "attachments": [],
      "content_sha256": "e7429ff1d4977920bfa4397a770d30077bb27da0f9bb140503165c0bab5cba83",
      "disqualified": [],
      "id": "helsinki/palvelukeskusliikelaitoksen-johtokunta/2026-04-10/2",
      "meeting_id": "helsinki/palvelukeskusliikelaitoksen-johtokunta/2026-04-10",
