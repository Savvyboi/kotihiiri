      "id": "helsinki/taloushallintopalveluliikelaitoksen-johtokunta/2026-02-25/2",
      "meeting_id": "helsinki/taloushallintopalveluliikelaitoksen-johtokunta/2026-02-25",
      "motions": [],
      "ordinal": 2,
      "preparers": [],
      "presenter": "Anniina Kitula",
      "pykala": 6,
      "sections": [
        {
          "heading": "Päätös",
          "text": "Taloushallintopalveluliikelaitoksen johtokunta päätti hyväksyä Helsingin kaupungin taloushallintopalveluliikelaitoksen tilinpäätöksen tilikaudelta 1.1.-31.12.2025 liitteenä olevan tilinpäätöskirjan mukaisesti sekä päätti esittää kaupunginhallitukselle, että tilikauden ylijäämä 622.360,03 euroa siirretään Taloushallintopalveluliikelaitoksen edellisten tilikausien yli-/alijäämiin.",
          "type": "decision"
        },
        {
          "heading": "Päätösehdotus",
          "text": "Päätös on ehdotuksen mukainen.",
          "type": "proposal"
        },
        {
          "heading": "Esittelijän perustelut",
          "text": "Taloushallintopalveluliikelaitos on laatinut tilinpäätöksen kaupungin ohjeiden ja aikataulujen mukaisesti. Yksityiskohtainen selvitys liikelaitoksen toiminnasta on kuvattu ehdotuksen liitteessä olevassa tilinpäätöksessä. Tilinpäätöstä koskeva tilintarkastus on suoritettu 9.-13.2.2026. Tarkastuksen perusteella tilinpäätös antaa oikean ja riittävän kuvan tilikauden tuloksesta ja taloudellisesta asemasta.",
          "type": "background"
        }
      ],
