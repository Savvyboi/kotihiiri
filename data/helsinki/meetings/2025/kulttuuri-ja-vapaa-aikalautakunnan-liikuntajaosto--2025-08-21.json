      "pykala": 17,
      "sections": [
        {
          "heading": "Päätös",
          "text": "Kulttuuri- ja vapaa-aikalautakunnan liikuntajaosto kokoontuu syyskaudella 2025 seuraavasti:\n\nto 30.10.2025 | klo 16.15\n\nti 2.12.2025 | klo 16.15\n\nLiikuntajaosto kokoontuu Fredriksbergin B-talossa lautakunnan kokoushuoneessa osoitteessa Konepajankuja 3.",
          "type": "decision"
        },
        {
          "heading": "Päätösehdotus",
          "text": "Päätös on ehdotuksen mukainen.",
          "type": "proposal"
        },
        {
          "heading": "Esittelijän perustelut",
          "text": "Helsingin kaupungin hallintosäännön 29 luvun 2 §:n 2 momentin mukaan toimielin kokoontuu päättäminään aikoina sekä lisäksi puheenjohtajan kutsusta ja 3 momentin mukaan toimielimen puheenjohtaja voi asioiden vähäisen määrän tai muun erityisen syyn vuoksi peruuttaa kokouksen tai muuttaa kokouksen alkamisaikaa päätettynä kokouspäivänä.",
          "type": "background"
        }
      ],
