        {
          "heading": "Päätös",
          "text": "Kulttuuri- ja vapaa-aikalautakunnan liikuntajaosto totesi kokouksen laillisesti koolle kutsutuksi ja päätösvaltaiseksi.\n\nKulttuuri- ja vapaa-aikalautakunnan liikuntajaosto valitsi pöytäkirjantarkastajiksi jäsenet Essi Pöysti ja Lari Kangas sekä varatarkastajiksi jäsenet Jenni Janakka ja Ludwig Löcke.",
          "type": "decision"
        },
        {
          "heading": "Päätösehdotus",
          "text": "Päätös on ehdotuksen mukainen.",
          "type": "proposal"
        }
      ],
