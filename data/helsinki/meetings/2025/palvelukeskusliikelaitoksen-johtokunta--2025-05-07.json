      "sections": [
        {
          "heading": "Päätös",
          "text": "Palvelukeskusliikelaitoksen johtokunta päätti, ettei se ota käsiteltäväkseen seuraavien viranomaisten 14.2.-8.4.2025 tekemiä päätöksiä:\n\nToimitusjohtaja | 14.2.2025 §5 toisen optiovuoden käyttöönotto elintarvikekuljetukset\n\nYksikönjohtaja | 19.3.2025 §2 option käyttöönotto, työvaatteet\n\nYksikönjohtaja | 21.3.2025 §1 option käyttöönotto, työvaatteet\n\nYksikönjohtaja | 21.3.2025 §2 option käyttöönotto, pesulapalvelu\n\nToimitusjohtaja | 8.4.2025 §6 Virvoitusjuomat ja kivennäisvedet hankinta\n\nToimitusjohtaja | 29.4.2025 §7 muistiotositteiden ja maksuosoitusten hyväksyntä",
          "type": "decision"
        },
        {
          "heading": "Päätösehdotus",
          "text": "Päätös on ehdotuksen mukainen.",
          "type": "proposal"
        }
      ],
