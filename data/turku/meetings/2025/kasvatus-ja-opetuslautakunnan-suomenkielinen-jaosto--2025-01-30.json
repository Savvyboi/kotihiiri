    {
      "attachments": [],
      "case_number": "720/2025",
      "content_sha256": "a616ed07bc2df9e788b5c65e6f28d6c4b67e98c80285290b4b071c67516a6cd6",
      "disqualified": [],
      "id": "turku/kasvatus-ja-opetuslautakunnan-suomenkielinen-jaosto/2025-01-30/7",
      "meeting_id": "turku/kasvatus-ja-opetuslautakunnan-suomenkielinen-jaosto/2025-01-30",
      "motions": [],
      "ordinal": 7,
      "preparers": [],
      "pykala": 7,
      "sections": [
        {
          "text": "Palvelualuejohtaja Vesa Kulmala 24.1.2025:\n\n1 . | Kaupunginhallitus päätti 19.12.2024 § 424, ettei se ota käsittelyynsä kasvatus- ja opetuslautakunnan suomenkielisen jaoston 12.12.2024 pöytäkirjaa.\n\n2 . | Ka svatus- ja opetuslautakunta päätti 17.12.2024 § 159, ettei se ota käsittelyynsä kasvatus- ja opetuslautakunnan suomenkielisen jaoston 12.12.2024 pöytäkirjaa.\n\n3. | Kaupungin valtuusto päätti 16 .12.2024 § 183 päätt i myöntää Selmi Holopaiselle eron kasvatus- ja opetuslautakunnan suomenkielisen jaoston varajäsenen tehtävästä ja valita Claire Bellin hänen tilalleen Jenni Jäntin henkilökohtaiseksi varajäseneksi.\n\n4 . | Kasvatus- ja opetusjohtaja päätöksellä 17.12.2024 § 131 päätti ottaa kasvatus- ja opetuslautakunnan käsiteltäväksi kasvatus- ja opetuslautakunnan suomenkielisen jaoston päätöksen 12.12.2024 § 88 ”Perusopetuksessa toteuttavasta katsomusaineiden osittaisesta yhteisopetuksesta luopuminen”.\n\nEhdotus Kasvatus- ja opetuslautakunnan suomenkielinen jaosto päättää merkitä ilmoitusasiat tiedokseen.",
          "type": "background"
        },
        {
          "heading": "Päätös",
          "text": "Ehdotus hyväksyttiin.",
          "type": "decision"
        }
      ],
