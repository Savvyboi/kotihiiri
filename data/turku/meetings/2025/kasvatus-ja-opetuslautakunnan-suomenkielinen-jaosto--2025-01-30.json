    {
      "attachments": [],
      "case_number": "13309/2021",
      "content_sha256": "fb0d0c8e322d28837db2f1123acfacbcc588408edf181f2af0399c970414d774",
      "disqualified": [],
      "id": "turku/kasvatus-ja-opetuslautakunnan-suomenkielinen-jaosto/2025-01-30/4",
      "meeting_id": "turku/kasvatus-ja-opetuslautakunnan-suomenkielinen-jaosto/2025-01-30",
      "motions": [],
      "ordinal": 4,
      "preparers": [],
      "pykala": 4,
      "sections": [
        {
          "text": "Ammatillisen koulutuksen palvelualuejohtaja Hannu Immonen 20.1.2025:\n\nKasvatus- ja opetuslautakunnan suomenkielinen jaosto päätti kokouksessaan 11.11.2021 § 30 ammatillisten neuvottelukuntien nimeämisestä toimikaudelle 2022 - 2025.\n\nErkki Kulmala ei ole enää käytettävissä Ammattiopisto Spesia Oy:n edustajana autoalan ammatillisessa neuvottelukunnassa 1.1.2025 lukien. Autoalan ammatillinen neuvottelukunta esittää Erkki Kulmalan tilalle Sauli Saarista Ammattiopisto Spesia Oy:stä.\n\nEhdotus Kasvatus- ja opetuslautakunnan suomenkielinen jaosto päättää valita Sauli Saarisen autoalan ammatillisen neuvottelukunnan jäseneksi Erkki Kulmalan tilalle päätöksentekopäivästä alkaen toimikauden loppuun saakka.",
          "type": "background"
        },
        {
          "heading": "Päätös",
          "text": "Ehdotus hyväksyttiin.\n\nJakelu\n\naoXXXXX\n\naoXXXXX\n\ntiedKasvatus ja opetus, ammatillinen koulutus\n\ntpvXXXXX",
          "type": "decision"
        }
      ],
